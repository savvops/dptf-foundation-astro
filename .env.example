# Copy to .env for local dev. In production, set these in the
# Cloudflare Pages dashboard (Settings → Environment variables).

# Optional PIN lock for the whole site
PUBLIC_ENABLE_PIN_LOCK=false
PUBLIC_SITE_PIN=0000

# --- Paystack donations ---
# Public key — safe to expose to the browser. Use pk_test_ while testing,
# pk_live_ in production. Required, or the donate buttons show "unavailable".
PUBLIC_PAYSTACK_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Secret key — server-only, used by /api/verify-donation. NEVER prefix PUBLIC_.
# In Cloudflare, add this as an ENCRYPTED secret, not a plain variable.
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
