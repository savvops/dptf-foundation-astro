---
// Simple Content Editor - Links directly to GitHub
const siteUrl = Astro.url.origin;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Edit Content - DPTF Admin</title>
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      background: #0f172a;
      color: #e2e8f0;
      min-height: 100vh;
    }
    .header {
      background: #1e293b;
      padding: 1rem 2rem;
      border-bottom: 1px solid #334155;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    .header h1 { font-size: 1.25rem; color: #fff; }
    .header a { color: #94a3b8; text-decoration: none; font-size: 0.875rem; }
    .header a:hover { color: #3b82f6; }
    .container {
      max-width: 1200px;
      margin: 0 auto;
      padding: 2rem;
    }
    .intro {
      background: #1e293b;
      border-radius: 8px;
      padding: 1.5rem;
      margin-bottom: 2rem;
      border: 1px solid #334155;
    }
    .intro h2 { color: #fff; margin-bottom: 0.5rem; }
    .intro p { color: #94a3b8; line-height: 1.6; margin-bottom: 1rem; }
    .btn {
      display: inline-block;
      padding: 0.75rem 1.5rem;
      background: #3b82f6;
      color: white;
      text-decoration: none;
      border-radius: 6px;
      font-weight: 500;
    }
    .btn:hover { background: #2563eb; }
    .grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
      gap: 1rem;
    }
    .card {
      background: #1e293b;
      border-radius: 8px;
      padding: 1.5rem;
      border: 1px solid #334155;
    }
    .card h3 {
      color: #fff;
      font-size: 1rem;
      margin-bottom: 1rem;
      padding-bottom: 0.5rem;
      border-bottom: 1px solid #334155;
    }
    .card ul { list-style: none; }
    .card li { margin-bottom: 0.75rem; }
    .card a {
      color: #94a3b8;
      text-decoration: none;
      font-size: 0.875rem;
      display: flex;
      align-items: center;
      gap: 0.5rem;
      padding: 0.5rem;
      border-radius: 4px;
      transition: all 0.2s;
    }
    .card a:hover { color: #3b82f6; background: #0f172a; }
    .images-section {
      margin-top: 2rem;
      background: #1e293b;
      border-radius: 8px;
      padding: 1.5rem;
      border: 1px solid #334155;
    }
    .images-section h2 { color: #fff; margin-bottom: 1rem; }
    .images-section p { color: #94a3b8; margin-bottom: 1rem; }
    .images-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
      gap: 1rem;
    }
    .image-link {
      background: #0f172a;
      padding: 1.25rem;
      border-radius: 6px;
      text-align: center;
      border: 1px solid #334155;
    }
    .image-link a {
      color: #3b82f6;
      text-decoration: none;
      font-weight: 500;
    }
    .note {
      background: #0f172a;
      border-left: 4px solid #3b82f6;
      padding: 1rem;
      margin-bottom: 2rem;
      border-radius: 0 6px 6px 0;
    }
    .note p { color: #94a3b8; font-size: 0.875rem; }
    .warning {
      background: #451a03;
      border: 1px solid #92400e;
      color: #fdba74;
      padding: 1rem;
      border-radius: 6px;
      margin-bottom: 1rem;
    }
  </style>
</head>
<body>
  <div class="header">
    <h1>📝 Edit Website Content</h1>
    <a href="{siteUrl}">← Back to Website</a>
  </div>
  
  <div class="container">
    <div class="intro">
      <h2>Edit via GitHub</h2>
      <p>Click any folder below to browse and edit content on GitHub. Changes automatically deploy to your site in 1-2 minutes.</p>
      <a href="https://github.com/savvops/dptf-foundation-astro/tree/main/src/content" target="_blank" class="btn">📁 Browse All Content</a>
    </div>
    
    <div class="warning">
      <strong>⚠️ Login Required:</strong> You must be logged into GitHub with write access to edit files.
    </div>
    
    <div class="grid">
      <div class="card">
        <h3>⚙️ Site Settings</h3>
        <ul>
          <li><a href="https://github.com/savvops/dptf-foundation-astro/blob/main/src/content/siteSettings/settings.json" target="_blank">⚙️ Site Settings</a></li>
          <li><a href="https://github.com/savvops/dptf-foundation-astro/tree/main/src/content/navigation" target="_blank">📁 Navigation</a></li>
          <li><a href="https://github.com/savvops/dptf-foundation-astro/tree/main/src/content/footerLinks" target="_blank">📁 Footer Links</a></li>
          <li><a href="https://github.com/savvops/dptf-foundation-astro/tree/main/src/content/socialLinks" target="_blank">📁 Social Media</a></li>
        </ul>
      </div>
      
      <div class="card">
        <h3>🏠 Homepage</h3>
        <ul>
          <li><a href="https://github.com/savvops/dptf-foundation-astro/tree/main/src/content/homepage" target="_blank">📁 Homepage Sections</a></li>
          <li><a href="https://github.com/savvops/dptf-foundation-astro/tree/main/src/content/stats" target="_blank">📁 Stats</a></li>
          <li><a href="https://github.com/savvops/dptf-foundation-astro/tree/main/src/content/coreValues" target="_blank">📁 Core Values</a></li>
          <li><a href="https://github.com/savvops/dptf-foundation-astro/tree/main/src/content/objectives" target="_blank">📁 Objectives</a></li>
        </ul>
      </div>
      
      <div class="card">
        <h3>👥 About Page</h3>
        <ul>
          <li><a href="https://github.com/savvops/dptf-foundation-astro/tree/main/src/content/aboutSettings" target="_blank">📁 About Settings</a></li>
          <li><a href="https://github.com/savvops/dptf-foundation-astro/tree/main/src/content/board" target="_blank">📁 Board Members</a></li>
          <li><a href="https://github.com/savvops/dptf-foundation-astro/tree/main/src/content/boardSettings" target="_blank">📁 Board Settings</a></li>
          <li><a href="https://github.com/savvops/dptf-foundation-astro/tree/main/src/content/timeline" target="_blank">📁 Timeline</a></li>
        </ul>
      </div>
      
      <div class="card">
        <h3>📋 Our Work</h3>
        <ul>
          <li><a href="https://github.com/savvops/dptf-foundation-astro/tree/main/src/content/ourWorkSettings" target="_blank">📁 Page Settings</a></li>
          <li><a href="https://github.com/savvops/dptf-foundation-astro/tree/main/src/content/programs" target="_blank">📁 Programs</a></li>
          <li><a href="https://github.com/savvops/dptf-foundation-astro/tree/main/src/content/impactAreas" target="_blank">📁 Impact Areas</a></li>
          <li><a href="https://github.com/savvops/dptf-foundation-astro/tree/main/src/content/medicalOutreaches" target="_blank">📁 Medical Outreaches</a></li>
        </ul>
      </div>
      
      <div class="card">
        <h3>❓ FAQ</h3>
        <ul>
          <li><a href="https://github.com/savvops/dptf-foundation-astro/tree/main/src/content/faqSettings" target="_blank">📁 FAQ Settings</a></li>
          <li><a href="https://github.com/savvops/dptf-foundation-astro/tree/main/src/content/faqCategories" target="_blank">📁 Categories</a></li>
          <li><a href="https://github.com/savvops/dptf-foundation-astro/tree/main/src/content/faqItems" target="_blank">📁 Questions</a></li>
        </ul>
      </div>
      
      <div class="card">
        <h3>🤝 Get Involved</h3>
        <ul>
          <li><a href="https://github.com/savvops/dptf-foundation-astro/tree/main/src/content/getInvolvedSettings" target="_blank">📁 Page Settings</a></li>
          <li><a href="https://github.com/savvops/dptf-foundation-astro/tree/main/src/content/donationAmounts" target="_blank">📁 Donation Amounts</a></li>
          <li><a href="https://github.com/savvops/dptf-foundation-astro/tree/main/src/content/donationMethods" target="_blank">📁 Donation Methods</a></li>
          <li><a href="https://github.com/savvops/dptf-foundation-astro/tree/main/src/content/bankDetails" target="_blank">📁 Bank Details</a></li>
        </ul>
      </div>
      
      <div class="card">
        <h3>📊 Transparency</h3>
        <ul>
          <li><a href="https://github.com/savvops/dptf-foundation-astro/tree/main/src/content/transparencySettings" target="_blank">📁 Settings</a></li>
          <li><a href="https://github.com/savvops/dptf-foundation-astro/tree/main/src/content/financialReports" target="_blank">📁 Financial Reports</a></li>
          <li><a href="https://github.com/savvops/dptf-foundation-astro/tree/main/src/content/activityReports" target="_blank">📁 Activity Reports</a></li>
          <li><a href="https://github.com/savvops/dptf-foundation-astro/tree/main/src/content/meetingNotices" target="_blank">📁 Meeting Notices</a></li>
        </ul>
      </div>
      
      <div class="card">
        <h3>📞 Contact & More</h3>
        <ul>
          <li><a href="https://github.com/savvops/dptf-foundation-astro/tree/main/src/content/contactSettings" target="_blank">📁 Contact Settings</a></li>
          <li><a href="https://github.com/savvops/dptf-foundation-astro/tree/main/src/content/contactInfo" target="_blank">📁 Contact Info</a></li>
          <li><a href="https://github.com/savvops/dptf-foundation-astro/tree/main/src/content/memorialActivities" target="_blank">📁 Memorial</a></li>
          <li><a href="https://github.com/savvops/dptf-foundation-astro/tree/main/src/content/trustBadges" target="_blank">📁 Trust Badges</a></li>
        </ul>
      </div>
    </div>
    
    <div class="images-section">
      <h2>🖼️ Manage Images</h2>
      <p>Reference images in content as <code>/images/folder/image.jpg</code></p>
      <div class="images-grid">
        <div class="image-link">
          <a href="https://github.com/savvops/dptf-foundation-astro/tree/main/public/images" target="_blank">📁 All Images</a>
          <p style="font-size: 0.75rem; color: #64748b; margin-top: 0.5rem;">Main image folder</p>
        </div>
        <div class="image-link">
          <a href="https://github.com/savvops/dptf-foundation-astro/tree/main/public/images/members" target="_blank">👥 Member Photos</a>
          <p style="font-size: 0.75rem; color: #64748b; margin-top: 0.5rem;">Board & team photos</p>
        </div>
        <div class="image-link">
          <a href="https://github.com/savvops/dptf-foundation-astro/tree/main/public/reports" target="_blank">📄 PDF Reports</a>
          <p style="font-size: 0.75rem; color: #64748b; margin-top: 0.5rem;">Financial reports</p>
        </div>
      </div>
    </div>
    
    <div class="note" style="margin-top: 2rem;">
      <p>💡 <strong>How to edit:</strong> Click folder → Click file → Click ✏️ pencil icon → Edit → Scroll down → Click "Commit changes"</p>
    </div>
  </div>
</body>
</html>
---
