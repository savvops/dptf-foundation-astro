---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/sections/Navbar.astro';
import Footer from '../components/sections/Footer.astro';
import Icon from '../components/ui/Icon.astro';
import { getCollection, getEntry } from 'astro:content';

// Load FAQ settings
const faqSettings = await getEntry('faqSettings', 'settings');

// Load FAQ categories
const faqCategories = await getCollection('faqCategories');
const enabledCategories = faqCategories
  .filter(cat => cat.data.enabled)
  .sort((a, b) => a.data.order - b.data.order);

// Load FAQ items
const faqItems = await getCollection('faqItems');
const enabledFaqItems = faqItems
  .filter(item => item.data.enabled)
  .sort((a, b) => a.data.order - b.data.order);

// Group FAQ items by category
const faqByCategory = enabledCategories.map(category => ({
  category: category.data,
  items: enabledFaqItems.filter(item => item.data.categoryId === category.data.id)
})).filter(group => group.items.length > 0);

// Load contact info for phone
const contactInfo = await getCollection('contactInfo');
const phoneInfo = contactInfo.find(item => item.data.id === 'phone');
---

<Layout title={faqSettings.data.pageTitle} description={faqSettings.data.pageDescription}>
  <Navbar />
  <main id="main-content" class="pt-32 pb-20">
    <div class="container mx-auto px-4 max-w-4xl">
      <!-- Header -->
      <div class="text-center mb-12">
        <h1 class="font-display text-4xl md:text-5xl font-bold text-primary mb-4">
          {faqSettings.data.headerTitle}
        </h1>
        <p class="text-lg text-gray-600 max-w-2xl mx-auto">
          {faqSettings.data.headerDescription}
        </p>
      </div>

      <!-- Category Navigation -->
      <div class="flex flex-wrap justify-center gap-2 mb-12">
        {enabledCategories.map((cat, index) => (
          <a 
            href={`#category-${index}`}
            class="px-4 py-2 bg-white border border-gray-200 rounded-full text-sm font-medium text-gray-700 hover:border-primary hover:text-primary transition-colors"
          >
            {cat.data.category}
          </a>
        ))}
      </div>

      <!-- FAQ Content -->
      <div class="space-y-12">
        {faqByCategory.map((group, catIndex) => (
          <section id={`category-${catIndex}`} class="scroll-mt-24">
            <h2 class="font-display text-2xl font-bold text-primary mb-6 flex items-center gap-3">
              <span class="w-8 h-8 bg-primary/10 rounded-lg flex items-center justify-center text-sm">
                {catIndex + 1}
              </span>
              {group.category.category}
            </h2>
            
            <div class="space-y-4">
              {group.items.map((item) => (
                <details class="group bg-white rounded-xl border border-gray-200 overflow-hidden">
                  <summary class="flex items-center justify-between p-5 cursor-pointer hover:bg-gray-50 transition-colors">
                    <span class="font-medium text-gray-900 pr-4">{item.data.question}</span>
                    <span class="flex-shrink-0 w-8 h-8 bg-primary/10 rounded-full flex items-center justify-center group-open:rotate-180 transition-transform">
                      <Icon name="chevron-down" class="w-5 h-5 text-primary" />
                    </span>
                  </summary>
                  <div class="px-5 pb-5 text-gray-600 leading-relaxed">
                    {item.data.answer}
                  </div>
                </details>
              ))}
            </div>
          </section>
        ))}
      </div>

      <!-- Still Have Questions -->
      <div class="mt-16 bg-primary/5 rounded-2xl p-8 md:p-12 text-center">
        <h2 class="font-display text-2xl font-bold text-primary mb-4">
          {faqSettings.data.stillHaveQuestionsTitle}
        </h2>
        <p class="text-gray-600 mb-6 max-w-xl mx-auto">
          {faqSettings.data.stillHaveQuestionsDescription}
        </p>
        <div class="flex flex-col sm:flex-row justify-center gap-4">
          <a 
            href="/contact" 
            class="inline-flex items-center justify-center gap-2 px-6 py-3 bg-primary text-white font-semibold rounded-lg hover:bg-primary-dark transition-colors"
          >
            <Icon name="mail" class="w-5 h-5" />
            Contact Us
          </a>
          {phoneInfo && (
            <a 
              href={phoneInfo.data.href} 
              class="inline-flex items-center justify-center gap-2 px-6 py-3 bg-white text-primary font-semibold rounded-lg border-2 border-primary hover:bg-primary/5 transition-colors"
            >
              <Icon name="phone" class="w-5 h-5" />
              Call Us
            </a>
          )}
        </div>
      </div>
    </div>
  </main>
  <Footer />
</Layout>

<style>
  details > summary {
    list-style: none;
  }
  details > summary::-webkit-details-marker {
    display: none;
  }
  details[open] summary ~ * {
    animation: sweep 0.3s ease-in-out;
  }
  @keyframes sweep {
    0%    {opacity: 0; transform: translateY(-10px)}
    100%  {opacity: 1; transform: translateY(0)}
  }
</style>
