---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/sections/Navbar.astro';
import Footer from '../components/sections/Footer.astro';
import Button from '../components/ui/Button.astro';
import { getCollection, getEntry } from 'astro:content';

// Load about settings
const aboutSettings = await getEntry('aboutSettings', 'settings');

// Load board members
const boardMembers = await getCollection('board');
const trustees = boardMembers
  .filter(m => m.data.category === 'trustees' && m.data.enabled)
  .sort((a, b) => a.data.order - b.data.order);
const advisers = boardMembers
  .filter(m => m.data.category === 'advisory' && m.data.enabled)
  .sort((a, b) => a.data.order - b.data.order);

// Load board settings
const boardSettings = await getEntry('boardSettings', 'settings');

// Load timeline (foundation only)
const timelineEvents = await getCollection('timeline');
const foundationTimeline = timelineEvents
  .filter(t => t.data.category === 'foundation' && t.data.enabled)
  .sort((a, b) => a.data.order - b.data.order);

// Load core values
const coreValues = await getCollection('coreValues');
const enabledCoreValues = coreValues
  .filter(v => v.data.enabled)
  .sort((a, b) => a.data.order - b.data.order);

// Load Dr. Patience timeline and virtues
const drPatienceTimeline = timelineEvents
  .filter(t => t.data.category === 'drPatience' && t.data.enabled)
  .sort((a, b) => a.data.order - b.data.order);

const drPatienceVirtues = await getCollection('drPatienceVirtues');
const enabledVirtues = drPatienceVirtues
  .filter(v => v.data.enabled)
  .sort((a, b) => a.data.order - b.data.order);

// Get site settings
const siteSettings = await getEntry('siteSettings', 'settings');
---

<Layout 
  title={aboutSettings.data.pageTitle} 
  description={aboutSettings.data.pageDescription}
>
  <Navbar />
  <main id="main-content" class="flex flex-col">
    <!-- Header -->
    <section class="bg-secondary py-16 md:py-24 pt-32">
      <div class="container mx-auto px-4 text-center">
        <h1 class="font-display text-4xl md:text-5xl font-bold text-primary">{aboutSettings.data.headerTitle}</h1>
        <p class="mt-4 text-lg text-gray-600 max-w-3xl mx-auto leading-relaxed">
          {aboutSettings.data.headerDescription}
        </p>
      </div>
    </section>

    <!-- Inspiration Section -->
    <section class="py-16 md:py-24 bg-white">
      <div class="container mx-auto px-4 grid grid-cols-1 md:grid-cols-5 gap-12 items-center">
        <div class="md:col-span-2">
          <div class="rounded-lg overflow-hidden shadow-2xl aspect-[3/4] max-w-sm mx-auto">
            <img
              src={aboutSettings.data.drPatienceImage}
              alt={`Portrait of ${aboutSettings.data.drPatienceName}, medical doctor and founder inspiration`}
              class="w-full h-full object-cover"
              width="400"
              height="533"
              loading="lazy"
              decoding="async"
            />
          </div>
        </div>
        <div class="md:col-span-3">
          <h2 class="font-display text-3xl font-bold mb-4 text-primary">Our Inspiration: The Life of {aboutSettings.data.drPatienceName}</h2>
          <div class="space-y-4 text-gray-600 text-base md:text-lg leading-relaxed">
            {aboutSettings.data.drPatienceBio.split('\n\n').map((paragraph) => (
              <p>{paragraph}</p>
            ))}
          </div>
          <a 
            href="/our-work"
            class="inline-flex items-center gap-2 px-6 py-3 bg-primary text-white rounded-lg hover:bg-primary-dark transition-colors font-medium mt-6"
          >
            <span>See Our Programs</span>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
            </svg>
          </a>
        </div>
      </div>
    </section>

    <!-- Who We Are Section -->
    <section class="py-16 md:py-20 bg-[#faf9f7]">
      <div class="container mx-auto px-4 text-center max-w-3xl">
        <h2 class="font-display text-3xl md:text-4xl font-bold text-primary">
          {aboutSettings.data.whoWeAreTitle}
        </h2>
        <p class="mt-6 text-lg text-gray-600 leading-relaxed">
          {aboutSettings.data.whoWeAreDescription}
        </p>
        <div class="mt-8 flex flex-col sm:flex-row justify-center gap-4">
          <Button href="/transparency" variant="outline" size="lg">
            View Our Reports
          </Button>
          <Button href="/get-involved" variant="primary" size="lg">
            Donate Now
          </Button>
        </div>
      </div>
    </section>

    <!-- Core Values -->
    <section class="py-16 md:py-24 bg-white">
      <div class="container mx-auto px-4">
        <div class="text-center max-w-3xl mx-auto mb-16">
          <h2 class="font-display text-3xl md:text-4xl font-bold text-primary">Our Core Values</h2>
          <p class="mt-4 text-lg text-gray-600">The principles that guide everything we do.</p>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
          {enabledCoreValues.map((value) => (
            <div class="bg-[#faf9f7] rounded-xl p-8 text-center shadow-sm">
              <h3 class="font-display text-xl font-bold text-primary mb-3">{value.data.title}</h3>
              <p class="text-gray-600">{value.data.description}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Guiding Belief Section -->
    <section class="bg-primary text-white py-16 md:py-20">
      <div class="container mx-auto px-4 text-center max-w-4xl space-y-6">
        <h2 class="font-display text-3xl font-bold">{aboutSettings.data.guidingBeliefTitle}</h2>
        <p class="text-xl md:text-2xl font-mono tracking-wide italic opacity-90 leading-relaxed">
          "{aboutSettings.data.guidingBeliefQuote}"
        </p>
        <p class="mt-2 text-lg max-w-2xl mx-auto leading-relaxed opacity-90">
          {aboutSettings.data.guidingBeliefDescription}
        </p>
      </div>
    </section>

    <!-- Board of Trustees Section -->
    <section class="py-16 md:py-24 bg-white">
      <div class="container mx-auto px-4">
        <div class="text-center max-w-3xl mx-auto mb-16">
          <h2 class="font-display text-3xl md:text-4xl font-bold text-primary">{boardSettings.data.trusteesTitle}</h2>
          <p class="mt-4 text-lg text-gray-600">
            {boardSettings.data.trusteesDescription}
          </p>
          {!boardSettings.data.showBoardPhotos && (
            <p class="mt-4 text-sm text-amber-600 bg-amber-50 inline-block px-4 py-2 rounded-full">
              {boardSettings.data.photosHiddenMessage}
            </p>
          )}
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          {trustees.map((member) => (
            <div class="bg-[#faf9f7] rounded-xl p-8 text-center hover:shadow-lg transition-shadow">
              {boardSettings.data.showBoardPhotos ? (
                <div class="w-24 h-24 mx-auto mb-4 rounded-full overflow-hidden border-4 border-white shadow-md">
                  <img 
                    src={member.data.image} 
                    alt={member.data.name}
                    class="w-full h-full object-cover"
                    loading="lazy"
                  />
                </div>
              ) : (
                <div class="w-24 h-24 bg-primary/10 rounded-full flex items-center justify-center mx-auto mb-4">
                  <span class="font-display text-3xl font-bold text-primary">{member.data.name.charAt(0)}</span>
                </div>
              )}
              <h3 class="font-display text-xl font-bold text-gray-900">{member.data.name}</h3>
              <p class="text-primary font-medium text-sm mt-1">{member.data.role}</p>
              <p class="text-gray-600 mt-3 text-sm">{member.data.description}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Board of Advisers Section -->
    <section class="py-16 md:py-24 bg-[#faf9f7]">
      <div class="container mx-auto px-4">
        <div class="text-center max-w-3xl mx-auto mb-16">
          <h2 class="font-display text-3xl md:text-4xl font-bold text-primary">{boardSettings.data.advisersTitle}</h2>
          <p class="mt-4 text-lg text-gray-600">
            {boardSettings.data.advisersDescription}
          </p>
          {!boardSettings.data.showBoardPhotos && (
            <p class="mt-4 text-sm text-amber-600 bg-amber-50 inline-block px-4 py-2 rounded-full">
              {boardSettings.data.photosHiddenMessage}
            </p>
          )}
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
          {advisers.map((member) => (
            <div class="bg-white rounded-xl p-8 shadow-sm text-center hover:shadow-md transition-shadow">
              {boardSettings.data.showBoardPhotos ? (
                <div class="w-20 h-20 mx-auto mb-4 rounded-full overflow-hidden border-4 border-gray-100">
                  <img 
                    src={member.data.image} 
                    alt={member.data.name}
                    class="w-full h-full object-cover"
                    loading="lazy"
                  />
                </div>
              ) : (
                <div class="w-20 h-20 bg-primary/10 rounded-full flex items-center justify-center mx-auto mb-4">
                  <span class="font-display text-2xl font-bold text-primary">{member.data.name.charAt(0)}</span>
                </div>
              )}
              <h3 class="font-display text-lg font-bold text-gray-900">{member.data.name}</h3>
              <p class="text-primary font-medium text-sm mt-1">{member.data.role}</p>
              <p class="text-gray-600 mt-3 text-sm">{member.data.description}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Legacy Timeline Section -->
    <section class="py-16 md:py-24 bg-white">
      <div class="container mx-auto px-4 max-w-3xl">
        <h2 class="font-display text-3xl md:text-4xl font-bold text-center mb-12">Our Journey</h2>
        <div class="relative">
          <div class="absolute left-1/2 h-full w-0.5 bg-gray-200 -translate-x-1/2"></div>
          <div class="space-y-12">
            {foundationTimeline.map((item) => (
              <div class="relative flex items-center">
                <div class="w-1/2 pr-8 text-right">
                  <h3 class="font-display text-2xl font-bold text-primary">{item.data.year}</h3>
                </div>
                <div class="absolute left-1/2 -translate-x-1/2 w-4 h-4 rounded-full bg-primary border-4 border-white shadow"></div>
                <div class="w-1/2 pl-8">
                  <p class="text-gray-600">{item.data.event}</p>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- Legal Status Section -->
    <section class="py-16 md:py-20 bg-[#faf9f7]">
      <div class="container mx-auto px-4 max-w-3xl text-center">
        <h2 class="font-display text-3xl font-bold text-primary mb-6">{aboutSettings.data.legalStatusTitle}</h2>
        <p class="text-lg text-gray-600 leading-relaxed">
          {aboutSettings.data.legalStatusDescription}
        </p>
        <div class="mt-8 flex flex-col sm:flex-row justify-center gap-4">
          <Button href="/transparency" variant="primary">
            View Financial Reports
          </Button>
          <Button href="/our-work" variant="outline">
            See Our Programs
          </Button>
        </div>
      </div>
    </section>

    <!-- Join Us Section -->
    <section class="py-16 md:py-24 bg-primary text-white">
      <div class="container mx-auto px-4 text-center max-w-3xl">
        <h2 class="font-display text-3xl md:text-4xl font-bold">
          {aboutSettings.data.joinSectionTitle}
        </h2>
        <p class="mt-4 text-lg leading-relaxed opacity-90">
          {aboutSettings.data.joinSectionDescription}
        </p>
        <div class="mt-8 flex flex-col sm:flex-row justify-center gap-4">
          <Button href="/get-involved" variant="white" size="lg">
            Donate Now
          </Button>
          <Button href="/contact" variant="outline-white" size="lg">
            Contact Us
          </Button>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
