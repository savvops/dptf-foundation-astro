---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/sections/Navbar.astro';
import Footer from '../components/sections/Footer.astro';
import Icon from '../components/ui/Icon.astro';
import Button from '../components/ui/Button.astro';
import { getCollection, getEntry } from 'astro:content';

// Load Get Involved settings
const getInvolvedSettings = await getEntry('getInvolvedSettings', 'settings');

// Load donation amounts
const donationAmounts = await getCollection('donationAmounts');
const enabledDonationAmounts = donationAmounts
  .filter(a => a.data.enabled)
  .sort((a, b) => a.data.order - b.data.order);

// Load donation methods
const donationMethods = await getCollection('donationMethods');
const enabledDonationMethods = donationMethods
  .filter(m => m.data.enabled)
  .sort((a, b) => a.data.order - b.data.order);

// Load impact areas
const impactAreas = await getCollection('impactAreas');
const enabledImpactAreas = impactAreas
  .filter(a => a.data.enabled)
  .sort((a, b) => a.data.order - b.data.order);

// Paystack public key — injected from env (PUBLIC_PAYSTACK_KEY).
// Swap the .env / Cloudflare value to your pk_live_ key to go live; no code change needed.
const paystackKey = import.meta.env.PUBLIC_PAYSTACK_KEY ?? '';
---

<Layout title={getInvolvedSettings.data.pageTitle} description={getInvolvedSettings.data.pageDescription}>
  <Navbar />
  <main id="main-content">
    {/* Hero Section */}
    <section class="relative min-h-[70vh] flex items-center justify-center overflow-hidden pt-20">
      {/* Background Image */}
      <div class="absolute inset-0">
        <img 
          src="/images/hero-get-involved.jpg" 
          alt="Get Involved with DPTF"
          class="w-full h-full object-cover"
        />
        <div class="absolute inset-0 bg-gradient-to-b from-primary/80 via-primary/60 to-primary/80"></div>
      </div>
      
      {/* Content */}
      <div class="relative z-10 container mx-auto px-4 text-center text-white">
        <h1 class="font-display text-5xl md:text-6xl font-bold mb-4 drop-shadow-lg">
          {getInvolvedSettings.data.heroTitle}
        </h1>
        <p class="text-xl md:text-2xl opacity-90 max-w-3xl mx-auto mb-6">
          {getInvolvedSettings.data.heroSubtitle}
        </p>
        <p class="text-lg opacity-80 max-w-2xl mx-auto">
          {getInvolvedSettings.data.heroDescription}
        </p>
        <div class="mt-8">
          <a 
            href="#donate" 
            class="inline-flex items-center gap-2 px-8 py-4 bg-white text-primary font-display font-bold rounded-full hover:bg-gray-100 transition-colors"
          >
            Donate Now
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"/>
            </svg>
          </a>
        </div>
      </div>
    </section>

    {/* Paystack Donation Section */}
    <section id="donate" class="py-16 md:py-20 bg-white" data-paystack-key={paystackKey}>
      <div class="container mx-auto px-4 max-w-5xl">
        <div class="text-center mb-12">
          <h2 class="font-display text-3xl font-bold text-primary">{getInvolvedSettings.data.donateSectionTitle}</h2>
          <p class="mt-4 text-gray-600">{getInvolvedSettings.data.donateSectionDescription}</p>
          <p class="text-sm text-gray-500 mt-2">Secure payment by Paystack • Nigerian & international cards accepted</p>
        </div>

        {/* Donor details — required so donors get a receipt and we can thank them */}
        <div class="max-w-2xl mx-auto mb-10 p-6 bg-[#faf9f7] rounded-xl">
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label for="donorName" class="block text-sm font-medium text-gray-700 mb-2">Your name</label>
              <input
                type="text"
                id="donorName"
                autocomplete="name"
                placeholder="Full name"
                class="w-full px-4 py-3 rounded-lg border border-gray-300 focus:border-primary focus:ring-2 focus:ring-primary/20 outline-none"
              />
            </div>
            <div>
              <label for="donorEmail" class="block text-sm font-medium text-gray-700 mb-2">Email <span class="text-red-500">*</span></label>
              <input
                type="email"
                id="donorEmail"
                required
                autocomplete="email"
                placeholder="you@example.com"
                class="w-full px-4 py-3 rounded-lg border border-gray-300 focus:border-primary focus:ring-2 focus:ring-primary/20 outline-none"
              />
            </div>
          </div>
          <p class="text-xs text-gray-500 mt-3">We use your email only to send your donation receipt. Choose an amount below to continue.</p>
          <p id="donateStatus" class="text-sm mt-3 hidden" role="status" aria-live="polite"></p>
        </div>

        {/* Donation Amounts Grid */}
        <div class="grid grid-cols-2 md:grid-cols-3 gap-4 max-w-4xl mx-auto">
          {enabledDonationAmounts.map((option) => (
            <button 
              class="group p-6 rounded-xl border-2 border-gray-200 hover:border-primary hover:bg-primary/5 transition-all text-center donation-btn"
              data-amount={option.data.amount}
              onclick={`payWithPaystack(${option.data.amount})`}
            >
              <p class="font-display text-2xl font-bold text-primary group-hover:scale-110 transition-transform">{option.data.label}</p>
              <p class="text-sm text-gray-600 mt-2">{option.data.impact}</p>
              <span class="inline-block mt-4 text-sm font-medium text-primary opacity-0 group-hover:opacity-100 transition-opacity">
                Click to Donate →
              </span>
            </button>
          ))}
        </div>

        {/* Custom Amount */}
        <div class="max-w-md mx-auto mt-8 p-6 bg-[#faf9f7] rounded-xl">
          <label class="block text-sm font-medium text-gray-700 mb-2">Or enter custom amount (₦)</label>
          <div class="flex gap-3">
            <input
              type="number"
              id="customAmount"
              min="1000"
              step="100"
              placeholder="Enter amount"
              class="flex-1 px-4 py-3 rounded-lg border border-gray-300 focus:border-primary focus:ring-2 focus:ring-primary/20 outline-none"
            />
            <button 
              onclick="payCustomAmount()"
              class="px-6 py-3 bg-primary text-white font-medium rounded-lg hover:bg-primary-dark transition-colors"
            >
              Donate
            </button>
          </div>
        </div>

        {/* Paystack Trust Badges */}
        <div class="flex flex-wrap justify-center items-center gap-6 mt-10 text-sm text-gray-500">
          <span class="flex items-center gap-2">
            <Icon name="shield-check" class="w-5 h-5 text-green-600" />
            Secured by Paystack
          </span>
          <span class="flex items-center gap-2">
            <Icon name="credit-card" class="w-5 h-5 text-primary" />
            All Cards Accepted
          </span>
          <span class="flex items-center gap-2">
            <Icon name="banknote" class="w-5 h-5 text-primary" />
            Bank Transfer
          </span>
          <span class="flex items-center gap-2">
            <Icon name="smartphone" class="w-5 h-5 text-primary" />
            USSD
          </span>
        </div>
      </div>
    </section>

    {/* All Donation Methods */}
    <section class="py-16 md:py-20 bg-[#faf9f7]">
      <div class="container mx-auto px-4">
        <div class="text-center mb-12">
          <h2 class="font-display text-3xl font-bold text-primary">{getInvolvedSettings.data.allWaysToGiveTitle}</h2>
          <p class="mt-4 text-gray-600">{getInvolvedSettings.data.allWaysToGiveDescription}</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 max-w-5xl mx-auto">
          {enabledDonationMethods.map((option) => (
            <div class={`bg-white rounded-2xl shadow-lg hover:shadow-xl transition-shadow duration-300 p-8 flex flex-col ${option.data.popular ? 'ring-2 ring-primary' : ''}`}>
              {option.data.popular && (
                <span class="bg-primary text-white text-xs font-bold px-3 py-1 rounded-full self-center mb-4">
                  RECOMMENDED
                </span>
              )}
              <div class="items-center text-center mb-6">
                <div class="mx-auto flex items-center justify-center h-16 w-16 rounded-full bg-primary/10 mb-4">
                  <Icon name={option.data.icon} class="w-8 h-8 text-primary" />
                </div>
                <h3 class="font-display text-xl font-bold">{option.data.title}</h3>
              </div>
              <div class="flex-grow">
                {option.data.content && (
                  <div class="space-y-3">
                    {option.data.content.map(item => (
                      <div class="bg-[#faf9f7] p-3 rounded-lg flex justify-between items-center">
                        <div>
                          <p class="text-sm font-semibold text-gray-500">{item.label}</p>
                          <p class="text-base font-mono tracking-wider text-dark">{item.value}</p>
                        </div>
                        <button 
                          class="copy-btn p-2 rounded-lg hover:bg-gray-200 transition-colors text-primary"
                          data-text={item.value}
                          onclick="copyToClipboard(this.getAttribute('data-text'), this)"
                        >
                          <Icon name="copy" class="w-4 h-4" />
                        </button>
                      </div>
                    ))}
                  </div>
                )}
                {option.data.description && (
                  <p class="text-gray-600 mb-4">{option.data.description}</p>
                )}
                {option.data.contactInfo && (
                  <p class="text-sm text-gray-500 italic mt-4">{option.data.contactInfo}</p>
                )}
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    {/* Impact Areas */}
    <section class="py-16 md:py-20 bg-white">
      <div class="container mx-auto px-4">
        <div class="text-center mb-12">
          <h2 class="font-display text-3xl font-bold text-primary">{getInvolvedSettings.data.whereDonationGoesTitle}</h2>
          <p class="mt-4 text-gray-600">{getInvolvedSettings.data.whereDonationGoesDescription}</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-8 max-w-5xl mx-auto">
          {enabledImpactAreas.map((area) => (
            <div class="bg-[#faf9f7] rounded-xl p-8 text-center">
              <div class="w-16 h-16 bg-primary/10 rounded-full flex items-center justify-center mx-auto mb-4">
                <Icon name={area.data.icon} class="w-8 h-8 text-primary" />
              </div>
              <h3 class="font-display text-xl font-bold text-gray-900 mb-2">{area.data.title}</h3>
              <p class="text-gray-600 mb-4">{area.data.description}</p>
              <span class="text-sm font-medium text-primary bg-primary/10 px-3 py-1 rounded-full">
                {area.data.stats}
              </span>
            </div>
          ))}
        </div>

        <div class="text-center mt-10">
          <Button href="/transparency" variant="outline">
            View Financial Reports
          </Button>
        </div>
      </div>
    </section>

    {/* Volunteer Section */}
    <section class="py-16 md:py-20 bg-[#faf9f7]">
      <div class="container mx-auto px-4 text-center max-w-3xl">
        <h2 class="font-display text-3xl font-bold text-primary mb-6">{getInvolvedSettings.data.volunteerSectionTitle}</h2>
        <p class="text-lg text-gray-600 mb-8">
          {getInvolvedSettings.data.volunteerSectionDescription}
        </p>
        <div class="flex flex-col sm:flex-row justify-center gap-4">
          <Button href="/volunteer" variant="primary" size="lg">
            Apply to Volunteer
          </Button>
          <Button href="/our-work" variant="outline" size="lg">
            See Our Programs
          </Button>
        </div>
      </div>
    </section>

    {/* Transparency CTA */}
    <section class="py-16 md:py-20 bg-primary text-white">
      <div class="container mx-auto px-4 text-center max-w-3xl">
        <h2 class="font-display text-3xl font-bold mb-6">{getInvolvedSettings.data.transparencyTitle}</h2>
        <p class="text-lg leading-relaxed opacity-90 mb-8">
          {getInvolvedSettings.data.transparencyDescription}
        </p>
        <div class="flex flex-col sm:flex-row justify-center gap-4">
          <Button href="/transparency" variant="white" size="lg">
            View All Reports
          </Button>
          <Button href="/gallery" variant="outline-white" size="lg">
            See Our Work
          </Button>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<script is:inline src="https://js.paystack.co/v1/inline.js"></script>
<script is:inline>
  // Public key is injected from env via the #donate section's data attribute.
  const PAYSTACK_PUBLIC_KEY = document.getElementById('donate')?.dataset.paystackKey || '';
  const MIN_AMOUNT = 1000;

  function showStatus(message, type) {
    const el = document.getElementById('donateStatus');
    if (!el) return;
    el.textContent = message;
    el.classList.remove('hidden', 'text-red-600', 'text-green-600', 'text-gray-600');
    el.classList.add(type === 'error' ? 'text-red-600' : type === 'success' ? 'text-green-600' : 'text-gray-600');
  }

  function getDonor() {
    const email = (document.getElementById('donorEmail')?.value || '').trim();
    const name = (document.getElementById('donorName')?.value || '').trim();
    const validEmail = /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email);
    if (!validEmail) {
      showStatus('Please enter a valid email address so we can send your receipt.', 'error');
      document.getElementById('donorEmail')?.focus();
      return null;
    }
    return { email, name };
  }

  function payWithPaystack(amount) {
    if (!PAYSTACK_PUBLIC_KEY) {
      showStatus('Donations are temporarily unavailable. Please try another method below.', 'error');
      return;
    }
    const donor = getDonor();
    if (!donor) return;

    showStatus('Opening secure payment window…', 'info');

    const handler = PaystackPop.setup({
      key: PAYSTACK_PUBLIC_KEY,
      email: donor.email,
      amount: amount * 100,
      currency: 'NGN',
      ref: 'DPTF_' + Date.now() + '_' + Math.floor(Math.random() * 1000000),
      metadata: {
        custom_fields: [
          { display_name: 'Donor Name', variable_name: 'donor_name', value: donor.name || 'Anonymous' },
        ],
      },
      callback: function(response) {
        showStatus('Confirming your donation…', 'info');
        // Verify server-side before thanking the donor — never trust the browser callback alone.
        fetch('/api/verify-donation', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ reference: response.reference }),
        })
          .then((r) => r.json())
          .then((data) => {
            if (data && data.verified) {
              window.location.href = '/thank-you?ref=' + encodeURIComponent(response.reference);
            } else {
              showStatus('We could not confirm your payment yet. If you were charged, email us with reference ' + response.reference + ' and we will sort it out.', 'error');
            }
          })
          .catch(function() {
            showStatus('Payment received (ref ' + response.reference + '), but confirmation is delayed. Please keep this reference.', 'info');
          });
      },
      onClose: function() {
        showStatus('Payment window closed. You can try again whenever you are ready.', 'info');
      },
    });
    handler.openIframe();
  }

  function payCustomAmount() {
    const amount = parseInt(document.getElementById('customAmount').value, 10);
    if (amount && amount >= MIN_AMOUNT) {
      payWithPaystack(amount);
    } else {
      showStatus('Please enter a valid amount (minimum ₦' + MIN_AMOUNT.toLocaleString() + ').', 'error');
    }
  }

  // Copy to clipboard function
  function copyToClipboard(text, btn) {
    navigator.clipboard.writeText(text).then(() => {
      const originalHTML = btn.innerHTML;
      btn.innerHTML = '<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-green-600"><polyline points="20 6 9 17 4 12"></polyline></svg>';
      setTimeout(() => {
        btn.innerHTML = originalHTML;
      }, 2000);
    });
  }
</script>
