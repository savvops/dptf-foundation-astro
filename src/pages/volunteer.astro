---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/sections/Navbar.astro';
import Footer from '../components/sections/Footer.astro';
import Button from '../components/ui/Button.astro';
import Icon from '../components/ui/Icon.astro';

const title = "Volunteer With Us | Dr. Patience Tsavnande Foundation";
const description = "Join our team of dedicated volunteers. Help us with medical outreaches, educational programs, and community service activities across Nigeria.";

const volunteerAreas = [
  {
    icon: 'heart-pulse',
    title: 'Medical Outreach',
    description: 'Assist with patient registration, vital signs, pharmacy distribution, and health education during our medical outreaches.'
  },
  {
    icon: 'graduation-cap',
    title: 'Educational Support',
    description: 'Help organize educational programs, mentorship sessions, and scholarship application reviews.'
  },
  {
    icon: 'users',
    title: 'Community Engagement',
    description: 'Participate in community sensitization, event coordination, and volunteer recruitment.'
  },
  {
    icon: 'camera',
    title: 'Media & Documentation',
    description: 'Capture photos and videos during events, help with social media, and maintain our digital archives.'
  },
  {
    icon: 'clipboard-list',
    title: 'Administrative Support',
    description: 'Assist with office tasks, report writing, data entry, and program coordination.'
  },
  {
    icon: 'truck',
    title: 'Logistics & Operations',
    description: 'Help with transportation, equipment setup, supply distribution, and venue coordination.'
  }
];
---

<Layout title={title} description={description}>
  <Navbar />
  <main id="main-content" class="pt-20">
    <!-- Hero Section -->
    <section class="bg-secondary py-16 md:py-24">
      <div class="container mx-auto px-4 text-center max-w-3xl">
        <h1 class="font-display text-4xl md:text-5xl font-bold text-primary">
          Volunteer With Us
        </h1>
        <p class="mt-4 text-lg text-gray-600">
          Join our community of dedicated volunteers working to continue Dr. Patience's legacy of service to humanity. 
          Your time and skills can make a real difference in the lives of those we serve.
        </p>
      </div>
    </section>

    <!-- Why Volunteer -->
    <section class="py-16 md:py-20 bg-white">
      <div class="container mx-auto px-4">
        <div class="grid md:grid-cols-3 gap-8 max-w-5xl mx-auto">
          <div class="text-center">
            <div class="w-16 h-16 bg-primary/10 rounded-full flex items-center justify-center mx-auto mb-4">
              <Icon name="heart" class="w-8 h-8 text-primary" />
            </div>
            <h3 class="font-display text-xl font-bold mb-2">Make an Impact</h3>
            <p class="text-gray-600">Directly contribute to improving lives in underserved communities across Nigeria.</p>
          </div>
          <div class="text-center">
            <div class="w-16 h-16 bg-primary/10 rounded-full flex items-center justify-center mx-auto mb-4">
              <Icon name="users" class="w-8 h-8 text-primary" />
            </div>
            <h3 class="font-display text-xl font-bold mb-2">Join a Community</h3>
            <p class="text-gray-600">Connect with like-minded individuals passionate about service and social impact.</p>
          </div>
          <div class="text-center">
            <div class="w-16 h-16 bg-primary/10 rounded-full flex items-center justify-center mx-auto mb-4">
              <Icon name="award" class="w-8 h-8 text-primary" />
            </div>
            <h3 class="font-display text-xl font-bold mb-2">Gain Experience</h3>
            <p class="text-gray-600">Develop new skills and gain valuable experience in nonprofit operations.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Volunteer Areas -->
    <section class="py-16 md:py-20 bg-[#faf9f7]">
      <div class="container mx-auto px-4">
        <div class="text-center mb-12">
          <h2 class="font-display text-3xl font-bold text-primary">Ways to Volunteer</h2>
          <p class="mt-4 text-gray-600">Choose an area where your skills and interests align</p>
        </div>

        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6 max-w-6xl mx-auto">
          {volunteerAreas.map((area) => (
            <div class="bg-white rounded-xl p-6 shadow-sm hover:shadow-md transition-shadow">
              <div class="w-12 h-12 bg-primary/10 rounded-lg flex items-center justify-center mb-4">
                <Icon name={area.icon} class="w-6 h-6 text-primary" />
              </div>
              <h3 class="font-display text-lg font-bold mb-2">{area.title}</h3>
              <p class="text-gray-600 text-sm">{area.description}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Volunteer Form -->
    <section class="py-16 md:py-24 bg-white" id="apply">
      <div class="container mx-auto px-4">
        <div class="max-w-2xl mx-auto">
          <div class="text-center mb-10">
            <h2 class="font-display text-3xl font-bold text-primary">Apply to Volunteer</h2>
            <p class="mt-4 text-gray-600">
              Fill out the form below and we'll get in touch with you about volunteer opportunities.
            </p>
          </div>

          <form id="volunteerForm" class="bg-gray-50 rounded-2xl p-8 md:p-10">
            <div class="grid md:grid-cols-2 gap-6 mb-6">
              <div>
                <label for="firstName" class="block text-sm font-medium text-gray-700 mb-2">First Name *</label>
                <input 
                  type="text" 
                  id="firstName" 
                  name="firstName" 
                  required
                  class="w-full px-4 py-3 rounded-lg border border-gray-300 focus:border-primary focus:ring-2 focus:ring-primary/20 outline-none transition-all"
                  placeholder="Your first name"
                />
              </div>
              <div>
                <label for="lastName" class="block text-sm font-medium text-gray-700 mb-2">Last Name *</label>
                <input 
                  type="text" 
                  id="lastName" 
                  name="lastName" 
                  required
                  class="w-full px-4 py-3 rounded-lg border border-gray-300 focus:border-primary focus:ring-2 focus:ring-primary/20 outline-none transition-all"
                  placeholder="Your last name"
                />
              </div>
            </div>

            <div class="mb-6">
              <label for="email" class="block text-sm font-medium text-gray-700 mb-2">Email Address *</label>
              <input 
                type="email" 
                id="email" 
                name="email" 
                required
                class="w-full px-4 py-3 rounded-lg border border-gray-300 focus:border-primary focus:ring-2 focus:ring-primary/20 outline-none transition-all"
                placeholder="your.email@example.com"
              />
            </div>

            <div class="mb-6">
              <label for="phone" class="block text-sm font-medium text-gray-700 mb-2">Phone Number *</label>
              <input 
                type="tel" 
                id="phone" 
                name="phone" 
                required
                class="w-full px-4 py-3 rounded-lg border border-gray-300 focus:border-primary focus:ring-2 focus:ring-primary/20 outline-none transition-all"
                placeholder="+234 XXX XXX XXXX"
              />
            </div>

            <div class="mb-6">
              <label for="location" class="block text-sm font-medium text-gray-700 mb-2">Location/City *</label>
              <input 
                type="text" 
                id="location" 
                name="location" 
                required
                class="w-full px-4 py-3 rounded-lg border border-gray-300 focus:border-primary focus:ring-2 focus:ring-primary/20 outline-none transition-all"
                placeholder="e.g., Kaduna, Lagos, Abuja"
              />
            </div>

            <div class="mb-6">
              <label class="block text-sm font-medium text-gray-700 mb-3">Areas of Interest (Select all that apply)</label>
              <div class="grid md:grid-cols-2 gap-3">
                {volunteerAreas.map((area) => (
                  <label class="flex items-center gap-3 p-3 bg-white rounded-lg border border-gray-200 cursor-pointer hover:border-primary transition-colors">
                    <input 
                      type="checkbox" 
                      name="interests" 
                      value={area.title}
                      class="w-4 h-4 text-primary border-gray-300 rounded focus:ring-primary"
                    />
                    <span class="text-sm text-gray-700">{area.title}</span>
                  </label>
                ))}
              </div>
            </div>

            <div class="mb-6">
              <label for="skills" class="block text-sm font-medium text-gray-700 mb-2">Skills & Experience</label>
              <textarea 
                id="skills" 
                name="skills" 
                rows="3"
                class="w-full px-4 py-3 rounded-lg border border-gray-300 focus:border-primary focus:ring-2 focus:ring-primary/20 outline-none transition-all resize-none"
                placeholder="Tell us about your relevant skills, experience, or qualifications..."
              ></textarea>
            </div>

            <div class="mb-8">
              <label for="availability" class="block text-sm font-medium text-gray-700 mb-2">Availability</label>
              <select 
                id="availability" 
                name="availability"
                class="w-full px-4 py-3 rounded-lg border border-gray-300 focus:border-primary focus:ring-2 focus:ring-primary/20 outline-none transition-all bg-white"
              >
                <option value="">Select your availability</option>
                <option value="weekdays">Weekdays</option>
                <option value="weekends">Weekends</option>
                <option value="evenings">Evenings only</option>
                <option value="flexible">Flexible</option>
                <option value="events">Event-based only</option>
              </select>
            </div>

            <div class="mb-6">
              <label for="message" class="block text-sm font-medium text-gray-700 mb-2">Why do you want to volunteer with us?</label>
              <textarea 
                id="message" 
                name="message" 
                rows="4"
                class="w-full px-4 py-3 rounded-lg border border-gray-300 focus:border-primary focus:ring-2 focus:ring-primary/20 outline-none transition-all resize-none"
                placeholder="Share your motivation for volunteering with DPTF..."
              ></textarea>
            </div>

            <button 
              type="submit" 
              class="w-full py-4 bg-primary text-white font-semibold rounded-lg hover:bg-primary-dark transition-colors flex items-center justify-center gap-2"
            >
              <span class="btn-text">Submit Application</span>
              <span class="btn-loading hidden">
                <svg class="animate-spin h-5 w-5" viewBox="0 0 24 24">
                  <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4" fill="none"></circle>
                  <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                </svg>
              </span>
            </button>

            <p class="text-xs text-gray-500 mt-4 text-center">
              By submitting this form, you agree to our volunteer terms. We respect your privacy and will only use your information for volunteer coordination.
            </p>
          </form>

          <!-- Success Message (hidden by default) -->
          <div id="formSuccess" class="hidden bg-green-50 border border-green-200 rounded-2xl p-8 text-center">
            <div class="w-16 h-16 bg-green-100 rounded-full flex items-center justify-center mx-auto mb-4">
              <Icon name="check" class="w-8 h-8 text-green-600" />
            </div>
            <h3 class="font-display text-2xl font-bold text-green-800 mb-2">Application Received!</h3>
            <p class="text-green-700">
              Thank you for your interest in volunteering with DPTF. We'll review your application and get back to you within 5-7 business days.
            </p>
            <div class="mt-6">
              <Button href="/our-work" variant="outline">
                Explore Our Programs
              </Button>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Contact CTA -->
    <section class="py-16 md:py-20 bg-primary text-white">
      <div class="container mx-auto px-4 text-center max-w-3xl">
        <h2 class="font-display text-3xl font-bold mb-4">Questions About Volunteering?</h2>
        <p class="text-lg opacity-90 mb-8">
          If you have any questions about volunteer opportunities, feel free to reach out to us directly.
        </p>
        <div class="flex flex-col sm:flex-row justify-center gap-4">
          <Button href="/contact" variant="white" size="lg">
            Contact Us
          </Button>
          <Button href="tel:+2347034980459" variant="outline-white" size="lg">
            Call Us
          </Button>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<script>
  const volunteerForm = document.getElementById('volunteerForm');
  const formSuccess = document.getElementById('formSuccess');

  volunteerForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    
    const submitBtn = volunteerForm.querySelector('button[type="submit"]') as HTMLButtonElement;
    const btnText = submitBtn?.querySelector('.btn-text');
    const btnLoading = submitBtn?.querySelector('.btn-loading');
    
    // Show loading state
    if (btnText && btnLoading) {
      btnText.classList.add('hidden');
      btnLoading.classList.remove('hidden');
    }
    submitBtn.disabled = true;
    
    // Collect form data
    const formData = new FormData(volunteerForm);
    const data = Object.fromEntries(formData);
    
    // Get checkbox values for interests
    const interests = Array.from(volunteerForm.querySelectorAll('input[name="interests"]:checked'))
      .map(cb => (cb as HTMLInputElement).value);
    
    const fullData = {
      ...data,
      interests,
      submittedAt: new Date().toISOString(),
      formType: 'volunteer-application'
    };
    
    try {
      // Send to Cloudflare Function or n8n webhook
      // For now, simulate submission
      await new Promise(resolve => setTimeout(resolve, 1500));
      
      // Hide form, show success
      volunteerForm.style.display = 'none';
      formSuccess?.classList.remove('hidden');
      
      // Scroll to success message
      formSuccess?.scrollIntoView({ behavior: 'smooth', block: 'center' });
      
    } catch (error) {
      console.error('Form submission error:', error);
      alert('There was an error submitting your application. Please try again or contact us directly.');
      
      // Reset button
      if (btnText && btnLoading) {
        btnText.classList.remove('hidden');
        btnLoading.classList.add('hidden');
      }
      submitBtn.disabled = false;
    }
  });
</script>
