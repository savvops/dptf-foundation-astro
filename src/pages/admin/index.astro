---
// Simple JSON Editor Admin for Cloudflare Pages
const siteUrl = Astro.url.origin;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>DPTF Admin - Content Editor</title>
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      background: #0f172a;
      color: #e2e8f0;
      min-height: 100vh;
    }
    .header {
      background: #1e293b;
      padding: 1rem 2rem;
      border-bottom: 1px solid #334155;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    .header h1 { font-size: 1.25rem; color: #fff; }
    .header .subtitle { font-size: 0.875rem; color: #94a3b8; }
    .container {
      display: flex;
      min-height: calc(100vh - 65px);
    }
    .sidebar {
      width: 280px;
      background: #1e293b;
      border-right: 1px solid #334155;
      overflow-y: auto;
    }
    .sidebar-section { border-bottom: 1px solid #334155; }
    .sidebar-title {
      padding: 1rem;
      font-size: 0.75rem;
      text-transform: uppercase;
      color: #64748b;
      font-weight: 600;
      letter-spacing: 0.05em;
    }
    .sidebar-item {
      padding: 0.75rem 1rem;
      cursor: pointer;
      transition: all 0.2s;
      border-left: 3px solid transparent;
      font-size: 0.875rem;
    }
    .sidebar-item:hover { background: #334155; border-left-color: #3b82f6; }
    .sidebar-item.active { background: #334155; border-left-color: #3b82f6; color: #fff; }
    .main {
      flex: 1;
      padding: 2rem;
      overflow-y: auto;
    }
    .editor-container {
      background: #1e293b;
      border-radius: 8px;
      border: 1px solid #334155;
      overflow: hidden;
    }
    .editor-header {
      background: #334155;
      padding: 1rem;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    .editor-header h2 { font-size: 1rem; color: #fff; }
    .btn {
      padding: 0.5rem 1rem;
      border-radius: 6px;
      border: none;
      cursor: pointer;
      font-size: 0.875rem;
      font-weight: 500;
      transition: all 0.2s;
    }
    .btn-primary { background: #3b82f6; color: white; }
    .btn-primary:hover { background: #2563eb; }
    .btn-primary:disabled { background: #475569; cursor: not-allowed; }
    .btn-secondary { background: #475569; color: #e2e8f0; margin-right: 0.5rem; }
    .editor-content { padding: 1rem; }
    textarea {
      width: 100%;
      min-height: 500px;
      background: #0f172a;
      border: 1px solid #334155;
      border-radius: 6px;
      padding: 1rem;
      color: #e2e8f0;
      font-family: 'Monaco', 'Menlo', monospace;
      font-size: 0.875rem;
      line-height: 1.5;
      resize: vertical;
    }
    textarea:focus { outline: none; border-color: #3b82f6; }
    .message {
      padding: 1rem;
      border-radius: 6px;
      margin-bottom: 1rem;
    }
    .message.error { background: #dc2626; color: white; }
    .message.success { background: #16a34a; color: white; }
    .message.info { background: #1e40af; color: white; }
    .message.warning { background: #ca8a04; color: white; }
    .hidden { display: none !important; }
    .setup-box {
      background: #1e293b;
      padding: 2rem;
      border-radius: 8px;
      max-width: 600px;
      margin: 2rem auto;
    }
    .setup-box h2 { color: #fff; margin-bottom: 1rem; }
    .setup-box p { color: #94a3b8; margin-bottom: 1rem; line-height: 1.6; }
    .setup-box ol { margin-left: 1.5rem; color: #94a3b8; line-height: 1.8; margin-bottom: 1rem; }
    .setup-box a { color: #3b82f6; }
    .token-input {
      width: 100%;
      padding: 0.75rem;
      background: #0f172a;
      border: 1px solid #334155;
      border-radius: 6px;
      color: #e2e8f0;
      font-family: monospace;
      font-size: 0.875rem;
      margin-bottom: 1rem;
    }
    .token-status {
      display: inline-block;
      padding: 0.25rem 0.75rem;
      border-radius: 9999px;
      font-size: 0.75rem;
      font-weight: 600;
    }
    .token-status.ready { background: #16a34a; color: white; }
    .token-status.missing { background: #dc2626; color: white; }
  </style>
</head>
<body>
  <div class="header">
    <div>
      <h1>📝 DPTF Content Editor</h1>
      <div class="subtitle">Edit website content directly</div>
    </div>
    <div style="display: flex; align-items: center; gap: 1rem;">
      <span id="tokenStatus" class="token-status missing">Enter Token</span>
      <div class="subtitle">{siteUrl}</div>
    </div>
  </div>
  
  <div class="container">
    <aside class="sidebar">
      <div class="sidebar-section">
        <div class="sidebar-title">⚙️ Site Settings</div>
        <div class="sidebar-item" data-file="src/content/siteSettings/settings.json">Site Settings</div>
        <div class="sidebar-item" data-file="src/content/navigation/main.json">Navigation</div>
        <div class="sidebar-item" data-file="src/content/footerSettings/settings.json">Footer Settings</div>
      </div>
      <div class="sidebar-section">
        <div class="sidebar-title">🏠 Homepage</div>
        <div class="sidebar-item" data-file="src/content/homepage/hero.json">Hero Section</div>
        <div class="sidebar-item" data-file="src/content/homepage/intro.json">Intro Section</div>
        <div class="sidebar-item" data-file="src/content/homepage/cta.json">CTA Section</div>
      </div>
      <div class="sidebar-section">
        <div class="sidebar-title">👥 About</div>
        <div class="sidebar-item" data-file="src/content/aboutSettings/settings.json">About Settings</div>
        <div class="sidebar-item" data-file="src/content/boardSettings/settings.json">Board Settings</div>
      </div>
      <div class="sidebar-section">
        <div class="sidebar-title">📋 Content</div>
        <div class="sidebar-item" data-file="src/content/programs/education.json">Programs</div>
        <div class="sidebar-item" data-file="src/content/faqSettings/settings.json">FAQ Settings</div>
        <div class="sidebar-item" data-file="src/content/contactSettings/settings.json">Contact Settings</div>
      </div>
      <div class="sidebar-section">
        <div class="sidebar-title">🤝 Get Involved</div>
        <div class="sidebar-item" data-file="src/content/getInvolvedSettings/settings.json">Get Involved</div>
        <div class="sidebar-item" data-file="src/content/donationAmounts/1000.json">Donation Amounts</div>
      </div>
      <div class="sidebar-section">
        <div class="sidebar-title">📊 Transparency</div>
        <div class="sidebar-item" data-file="src/content/transparencySettings/settings.json">Transparency</div>
        <div class="sidebar-item" data-file="src/content/bankDetails/details.json">Bank Details</div>
      </div>
    </aside>
    
    <main class="main">
      <div id="message"></div>
      
      <div id="setup" class="setup-box">
        <h2>🔑 GitHub Token Required</h2>
        <p>To edit content, you need a GitHub Personal Access Token with <strong>repo</strong> access.</p>
        <ol>
          <li>Go to <a href="https://github.com/settings/tokens" target="_blank">github.com/settings/tokens</a></li>
          <li>Click "Generate new token (classic)"</li>
          <li>Check the <strong>repo</strong> checkbox (full control)</li>
          <li>Generate and copy the token</li>
          <li>Paste it below:</li>
        </ol>
        <input 
          type="text" 
          id="githubToken" 
          class="token-input" 
          placeholder="ghp_xxxxxxxxxxxxxxxxxxxx"
          autocomplete="off"
        >
        <p style="font-size: 0.75rem; color: #64748b; margin-top: 0.5rem;">
          💡 The token stays in your browser only. No server stores it.
        </p>
      </div>
      
      <div id="editor" class="editor-container hidden">
        <div class="editor-header">
          <h2 id="filename">Select a file</h2>
          <div>
            <button class="btn btn-secondary" onclick="resetChanges()">↩️ Reset</button>
            <button class="btn btn-primary" id="saveBtn" onclick="saveFile()">💾 Save Changes</button>
          </div>
        </div>
        <div class="editor-content">
          <textarea id="editorContent" placeholder="Select a file from the sidebar..."></textarea>
        </div>
      </div>
    </main>
  </div>

  <script>
    // CONFIG
    const REPO_OWNER = 'savvops';
    const REPO_NAME = 'dptf-foundation-astro';
    const BRANCH = 'main';
    
    let currentFile = null;
    let originalContent = '';
    
    // Get token from input field
    function getToken() {
      const token = document.getElementById('githubToken').value.trim();
      updateTokenStatus(token);
      return token;
    }
    
    function updateTokenStatus(token) {
      const status = document.getElementById('tokenStatus');
      if (token && token.length > 10) {
        status.textContent = 'Token Ready';
        status.className = 'token-status ready';
      } else {
        status.textContent = 'Enter Token';
        status.className = 'token-status missing';
      }
    }
    
    // Listen for token input
    document.getElementById('githubToken').addEventListener('input', () => {
      getToken();
    });
    
    function showMessage(text, type) {
      const msg = document.getElementById('message');
      msg.className = 'message ' + type;
      msg.textContent = text;
      if (type === 'success') {
        setTimeout(() => msg.className = 'hidden', 5000);
      }
    }
    
    async function loadFile(filepath) {
      const token = getToken();
      
      if (!token) {
        showMessage('Please enter your GitHub token above first', 'error');
        document.getElementById('githubToken').focus();
        return;
      }
      
      showMessage('Loading...', 'info');
      
      try {
        const response = await fetch(
          `https://api.github.com/repos/${REPO_OWNER}/${REPO_NAME}/contents/${filepath}?ref=${BRANCH}`,
          {
            headers: {
              'Authorization': `Bearer ${token}`,
              'Accept': 'application/vnd.github+json',
              'X-GitHub-Api-Version': '2022-11-28'
            }
          }
        );
        
        if (response.status === 401) {
          showMessage('Invalid token. Please check your GitHub token.', 'error');
          return;
        }
        
        if (response.status === 404) {
          // File doesn't exist, start with empty template
          originalContent = '{\n  \n}';
          document.getElementById('editorContent').value = originalContent;
        } else if (!response.ok) {
          const error = await response.json();
          showMessage('Error: ' + error.message, 'error');
          return;
        } else {
          const data = await response.json();
          const content = atob(data.content);
          originalContent = content;
          document.getElementById('editorContent').value = content;
        }
        
        currentFile = filepath;
        document.getElementById('filename').textContent = filepath;
        document.getElementById('setup').classList.add('hidden');
        document.getElementById('editor').classList.remove('hidden');
        document.getElementById('message').className = 'hidden';
        
        // Update active sidebar item
        document.querySelectorAll('.sidebar-item').forEach(item => {
          item.classList.remove('active');
          if (item.dataset.file === filepath) item.classList.add('active');
        });
        
      } catch (error) {
        showMessage('Network error: ' + error.message, 'error');
      }
    }
    
    async function saveFile() {
      const token = getToken();
      
      if (!token) {
        showMessage('Token missing', 'error');
        return;
      }
      
      if (!currentFile) {
        showMessage('No file selected', 'error');
        return;
      }
      
      const content = document.getElementById('editorContent').value;
      
      // Validate JSON
      try {
        JSON.parse(content);
      } catch (e) {
        showMessage('Invalid JSON: ' + e.message, 'error');
        return;
      }
      
      document.getElementById('saveBtn').disabled = true;
      showMessage('Saving...', 'info');
      
      try {
        // Get file SHA if it exists
        let sha = null;
        const getResponse = await fetch(
          `https://api.github.com/repos/${REPO_OWNER}/${REPO_NAME}/contents/${currentFile}?ref=${BRANCH}`,
          {
            headers: {
              'Authorization': `Bearer ${token}`,
              'Accept': 'application/vnd.github+json',
              'X-GitHub-Api-Version': '2022-11-28'
            }
          }
        );
        
        if (getResponse.ok) {
          const data = await getResponse.json();
          sha = data.sha;
        }
        
        // Save the file
        const body = {
          message: `Update ${currentFile} via admin`,
          content: btoa(unescape(encodeURIComponent(content))),
          branch: BRANCH
        };
        
        if (sha) body.sha = sha;
        
        const response = await fetch(
          `https://api.github.com/repos/${REPO_OWNER}/${REPO_NAME}/contents/${currentFile}`,
          {
            method: 'PUT',
            headers: {
              'Authorization': `Bearer ${token}`,
              'Accept': 'application/vnd.github+json',
              'Content-Type': 'application/json',
              'X-GitHub-Api-Version': '2022-11-28'
            },
            body: JSON.stringify(body)
          }
        );
        
        if (!response.ok) {
          const error = await response.json();
          throw new Error(error.message);
        }
        
        originalContent = content;
        showMessage('✅ Saved! Site will update in 1-2 minutes.', 'success');
        
      } catch (error) {
        showMessage('Save failed: ' + error.message, 'error');
      } finally {
        document.getElementById('saveBtn').disabled = false;
      }
    }
    
    function resetChanges() {
      if (confirm('Reset all changes?')) {
        document.getElementById('editorContent').value = originalContent;
      }
    }
    
    // Sidebar click handlers
    document.querySelectorAll('.sidebar-item').forEach(item => {
      item.addEventListener('click', () => {
        loadFile(item.dataset.file);
      });
    });
  </script>
</body>
</html>
---
