---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/sections/Navbar.astro';
import Footer from '../components/sections/Footer.astro';
import Button from '../components/ui/Button.astro';
import Icon from '../components/ui/Icon.astro';

const title = "Thank You | Dr. Patience Tsavnande Foundation";
const description = "Thank you for your message. We will get back to you shortly.";

// If a Paystack reference is present, this is a donation confirmation.
const donationRef = Astro.url.searchParams.get('ref');
const isDonation = Boolean(donationRef);
---

<Layout title={title} description={description}>
  <Navbar />
  <main id="main-content" class="pt-20 min-h-screen flex items-center">
    <div class="container mx-auto px-4 py-16 text-center max-w-2xl">
      <div class="w-20 h-20 bg-success/10 rounded-full flex items-center justify-center mx-auto mb-6">
        <Icon name="check" class="w-10 h-10 text-success" />
      </div>
      <h1 class="font-display text-4xl md:text-5xl font-bold text-primary mb-4">Thank You!</h1>
      {isDonation ? (
        <>
          <p class="text-lg text-gray-600 mb-4">
            Your donation to the Dr. Patience Tsavnande Foundation has been received. A receipt is on its way to your email. Your generosity directly supports medical care, food security, and education for those who need it most.
          </p>
          <p class="text-sm text-gray-500 mb-8">Reference: <span class="font-mono">{donationRef}</span></p>
        </>
      ) : (
        <p class="text-lg text-gray-600 mb-8">
          Your message has been received. We appreciate you reaching out to the Dr. Patience Tsavnande Foundation. Our team will review your message and get back to you as soon as possible.
        </p>
      )}
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <Button href="/" variant="primary">
          Return Home
        </Button>
        <Button href="/our-work" variant="outline">
          Explore Our Work
        </Button>
      </div>
    </div>
  </main>
  <Footer />
</Layout>
