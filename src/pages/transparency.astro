    size: "PDF"
  },
  {
    title: "Interim Report on Hope Project",
    date: "May 2024",
    description: "Progress report on the Foundation's participation in the Hope Project for employment and empowerment.",
    file: "/reports/00000805-Interim-Report-on-Hope-Project.pdf",
    size: "PDF"
  }
];

const meetingNotices = [
  {
    title: "Notice of BOT Meeting No6",
    date: "October 2025",
    type: "Board of Trustees"
  },
  {
    title: "Notice of General Meeting No8",
    date: "September 2023",
    type: "General Meeting"
  },
  {
    title: "Notice of General Meeting No7",
    date: "May 2023",
    type: "General Meeting"
  },
  {
    title: "Notice of BOT Meeting No5",
    date: "April 2023",
    type: "Board of Trustees"
  },
  {
