const impactStats = [
  { value: "₦2M+", label: "Donations Received" },
  { value: "1,053+", label: "Patients Treated" },
  { value: "3", label: "Medical Outreaches" },
  { value: "5+", label: "Years of Service" }
];
---

<Layout title={title} description={description}>
  <Navbar />
  <main id="main-content" class="flex flex-col">
    <!-- Hero Section -->
    <section class="bg-secondary py-16 md:py-24 pt-32">
      <div class="container mx-auto px-4 text-center">
        <h1 class="font-display text-4xl md:text-5xl font-bold text-primary">Transparency & Reports</h1>
        <p class="mt-4 text-lg text-gray-600 max-w-3xl mx-auto leading-relaxed">
          We are committed to full transparency and accountability. Here you can access our financial reports, activity reports, and see how your donations are making a difference.
        </p>
      </div>
    </section>

    {/* Impact Stats */}
    <section class="py-12 bg-primary text-white">
      <div class="container mx-auto px-4">
        <div class="grid grid-cols-2 md:grid-cols-4 gap-8 text-center">
          {impactStats.map((stat) => (
            <div>
              <p class="font-display text-3xl md:text-4xl font-bold">{stat.value}</p>
              <p class="text-sm mt-1 opacity-90">{stat.label}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    {/* Financial Reports */}
    <section class="py-16 md:py-24 bg-white">
      <div class="container mx-auto px-4 max-w-5xl">
        <div class="text-center mb-12">
          <h2 class="font-display text-3xl font-bold text-primary">Financial Reports</h2>
          <p class="mt-4 text-gray-600">
            Complete financial transparency is important to us. View our audited financial statements and budgets.
          </p>
          <p class="text-sm text-gray-500 mt-2">
            Last updated: {lastUpdated}
          </p>
        </div>

        <div class="space-y-4">
          {financialReports.map((report) => (
            <div class="bg-[#faf9f7] rounded-xl p-6 flex flex-col md:flex-row md:items-center justify-between gap-4">
              <div class="flex-1">
                <div class="flex items-center gap-3 mb-2">
                  <h3 class="font-display text-lg font-bold text-gray-900">{report.title}</h3>
                  <span class="text-xs bg-primary/10 text-primary px-2 py-1 rounded">{report.date}</span>
                </div>
                <p class="text-gray-600 text-sm">{report.description}</p>
              </div>
              <div class="flex items-center gap-3">
                <span class="text-sm text-gray-500">{report.size}</span>
                <a 
                  href={report.file}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-2 px-4 py-2 border-2 border-primary text-primary rounded-lg hover:bg-primary hover:text-white transition-colors text-sm font-medium"
                  aria-label={`View ${report.title} online`}
                >
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
                  </svg>
                  View
                </a>
                <a 
                  href={report.file}
                  download
                  class="inline-flex items-center gap-2 px-4 py-2 bg-primary text-white rounded-lg hover:bg-primary-dark transition-colors text-sm font-medium"
                  aria-label={`Download ${report.title}`}
                >
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
                  </svg>
                  Download
                </a>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    {/* Activity Reports */}
    <section class="py-16 md:py-24 bg-[#faf9f7]">
      <div class="container mx-auto px-4 max-w-5xl">
        <div class="text-center mb-12">
          <h2 class="font-display text-3xl font-bold text-primary">Activity Reports</h2>
          <p class="mt-4 text-gray-600">
            Detailed reports on our programs, outreaches, and events. See the impact we're making in communities across Nigeria.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          {activityReports.map((report) => (
            <div class="bg-white rounded-xl p-6 shadow-sm">
              <div class="flex items-start justify-between gap-4 mb-3">
                <h3 class="font-display text-lg font-bold text-gray-900">{report.title}</h3>
                <span class="text-xs bg-gray-100 text-gray-600 px-2 py-1 rounded flex-shrink-0">{report.date}</span>
              </div>
              <p class="text-gray-600 text-sm mb-4">{report.description}</p>
              <div class="flex items-center gap-3">
                <a 
                  href={report.file}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-2 px-3 py-1.5 border border-primary text-primary rounded-lg hover:bg-primary hover:text-white transition-colors text-sm font-medium"
                  aria-label={`View ${report.title} online`}
                >
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
                  </svg>
                  View
                </a>
                <a 
                  href={report.file}
                  download
                  class="inline-flex items-center gap-2 px-3 py-1.5 bg-primary text-white rounded-lg hover:bg-primary-dark transition-colors text-sm font-medium"
                  aria-label={`Download ${report.title}`}
                >
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
                  </svg>
                  Download
                </a>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    {/* Meeting Notices */}
    <section class="py-16 md:py-24 bg-white">
      <div class="container mx-auto px-4 max-w-4xl">
        <div class="text-center mb-12">
          <h2 class="font-display text-3xl font-bold text-primary">Meeting Notices</h2>
          <p class="mt-4 text-gray-600">
            Public notices of Foundation meetings. Meeting minutes are kept internal for administrative purposes.
          </p>
        </div>

        <div class="bg-[#faf9f7] rounded-xl overflow-hidden">
          <table class="w-full">
            <thead class="bg-primary text-white">
              <tr>
                <th class="text-left px-6 py-4 font-medium">Meeting Title</th>
                <th class="text-left px-6 py-4 font-medium">Date</th>
                <th class="text-left px-6 py-4 font-medium">Type</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-200">
              {meetingNotices.map((notice) => (
                <tr class="hover:bg-white transition-colors">
                  <td class="px-6 py-4 font-medium text-gray-900">{notice.title}</td>
                  <td class="px-6 py-4 text-gray-600">{notice.date}</td>
                  <td class="px-6 py-4">
                    <span class="text-xs bg-primary/10 text-primary px-2 py-1 rounded">{notice.type}</span>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </section>

    {/* Bank Account Info */}
    <section class="py-16 md:py-20 bg-[#faf9f7]">
      <div class="container mx-auto px-4 max-w-3xl">
        <div class="bg-white rounded-xl p-8 md:p-12 shadow-sm text-center">
          <h2 class="font-display text-2xl font-bold text-primary mb-6">Bank Account Details</h2>
          <p class="text-gray-600 mb-8">
            For direct bank transfers and donations, please use the account details below. All donations are fully accounted for and reported in our financial statements.
          </p>
          
          <div class="bg-[#faf9f7] rounded-xl p-8 max-w-md mx-auto">
            <div class="space-y-4 text-left">
              <div>
                <p class="text-sm text-gray-500">Account Name</p>
                <p class="font-display text-lg font-bold text-gray-900">Dr. Patience Selumun Tsavnande Foundation</p>
              </div>
              <div>
                <p class="text-sm text-gray-500">Account Number</p>
                <p class="font-display text-2xl font-bold text-primary">2035804521</p>
              </div>
              <div>
                <p class="text-sm text-gray-500">Bank</p>
                <p class="font-medium text-gray-900">First Bank of Nigeria</p>
              </div>
            </div>
          </div>

          <div class="mt-8">
            <Button href="/get-involved" variant="primary">
              Donate Online
            </Button>
          </div>
        </div>
      </div>
    </section>

    {/* Accountability Statement */}
    <section class="py-16 md:py-24 bg-primary text-white">
      <div class="container mx-auto px-4 max-w-4xl text-center">
        <h2 class="font-display text-3xl font-bold mb-6">Our Commitment to Accountability</h2>
        <p class="text-lg leading-relaxed opacity-90 mb-8">
          The Dr. Patience Selumun Tsavnande Foundation is registered with the Corporate Affairs Commission (CAC) of Nigeria. We maintain rigorous financial controls and transparency standards. Every naira donated is accounted for, and our financial reports are made publicly available.
        </p>
        <div class="flex flex-col sm:flex-row justify-center gap-4">
          <Button href="/contact" variant="white">
            Contact Us for More Info
          </Button>
          <Button href="/gallery" variant="outline-white">
            View Our Gallery
          </Button>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
