---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/sections/Navbar.astro';
import Footer from '../components/sections/Footer.astro';
import Button from '../components/ui/Button.astro';
import { getCollection, getEntry } from 'astro:content';

// Load transparency settings
const transparencySettings = await getEntry('transparencySettings', 'settings');

// Load bank details
const bankDetails = await getEntry('bankDetails', 'details');

// Load transparency stats
const transparencyStats = await getCollection('transparencyStats');
const enabledStats = transparencyStats
  .filter(stat => stat.data.enabled)
  .sort((a, b) => a.data.order - b.data.order);

// Load financial reports
const financialReports = await getCollection('financialReports');
const enabledFinancialReports = financialReports
  .filter(r => r.data.enabled)
  .sort((a, b) => a.data.order - b.data.order);

// Load activity reports
const activityReports = await getCollection('activityReports');
const enabledActivityReports = activityReports
  .filter(r => r.data.enabled)
  .sort((a, b) => a.data.order - b.data.order);

// Load meeting notices
const meetingNotices = await getCollection('meetingNotices');
const enabledMeetingNotices = meetingNotices
  .filter(n => n.data.enabled)
  .sort((a, b) => a.data.order - b.data.order);

// Last updated date
const lastUpdated = new Date().toLocaleDateString('en-NG', {
  year: 'numeric',
  month: 'long',
  day: 'numeric'
});
---

<Layout 
  title={transparencySettings.data.pageTitle} 
  description={transparencySettings.data.pageDescription}
>
  <Navbar />
  <main id="main-content" class="flex flex-col">
    <!-- Hero Section -->
    <section class="bg-secondary py-16 md:py-24 pt-32">
      <div class="container mx-auto px-4 text-center">
        <h1 class="font-display text-4xl md:text-5xl font-bold text-primary">{transparencySettings.data.heroTitle}</h1>
        <p class="mt-4 text-lg text-gray-600 max-w-3xl mx-auto leading-relaxed">
          {transparencySettings.data.heroDescription}
        </p>
      </div>
    </section>

    {/* Impact Stats */}
    <section class="py-12 bg-primary text-white">
      <div class="container mx-auto px-4">
        <div class="grid grid-cols-2 md:grid-cols-4 gap-8 text-center">
          {enabledStats.map((stat) => (
            <div>
              <p class="font-display text-3xl md:text-4xl font-bold">{stat.data.value}</p>
              <p class="text-sm mt-1 opacity-90">{stat.data.label}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    {/* Financial Reports */}
    <section class="py-16 md:py-24 bg-white">
      <div class="container mx-auto px-4 max-w-5xl">
        <div class="text-center mb-12">
          <h2 class="font-display text-3xl font-bold text-primary">{transparencySettings.data.financialReportsTitle}</h2>
          <p class="mt-4 text-gray-600">
            {transparencySettings.data.financialReportsDescription}
          </p>
          <p class="text-sm text-gray-500 mt-2">
            Last updated: {lastUpdated}
          </p>
        </div>

        <div class="space-y-4">
          {enabledFinancialReports.map((report) => (
            <div class="bg-[#faf9f7] rounded-xl p-6 flex flex-col md:flex-row md:items-center justify-between gap-4">
              <div class="flex-1">
                <div class="flex items-center gap-3 mb-2">
                  <h3 class="font-display text-lg font-bold text-gray-900">{report.data.title}</h3>
                  <span class="text-xs bg-primary/10 text-primary px-2 py-1 rounded">{report.data.date}</span>
                </div>
                <p class="text-gray-600 text-sm">{report.data.description}</p>
              </div>
              <div class="flex items-center gap-3">
                <span class="text-sm text-gray-500">{report.data.size}</span>
                <a 
                  href={report.data.file}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-2 px-4 py-2 border-2 border-primary text-primary rounded-lg hover:bg-primary hover:text-white transition-colors text-sm font-medium"
                  aria-label={`View ${report.data.title} online`}
                >
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
                  </svg>
                  View
                </a>
                <a 
                  href={report.data.file}
                  download
                  class="inline-flex items-center gap-2 px-4 py-2 bg-primary text-white rounded-lg hover:bg-primary-dark transition-colors text-sm font-medium"
                  aria-label={`Download ${report.data.title}`}
                >
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
                  </svg>
                  Download
                </a>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    {/* Activity Reports */}
    <section class="py-16 md:py-24 bg-[#faf9f7]">
      <div class="container mx-auto px-4 max-w-5xl">
        <div class="text-center mb-12">
          <h2 class="font-display text-3xl font-bold text-primary">{transparencySettings.data.activityReportsTitle}</h2>
          <p class="mt-4 text-gray-600">
            {transparencySettings.data.activityReportsDescription}
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          {enabledActivityReports.map((report) => (
            <div class="bg-white rounded-xl p-6 shadow-sm">
              <div class="flex items-start justify-between gap-4 mb-3">
                <h3 class="font-display text-lg font-bold text-gray-900">{report.data.title}</h3>
                <span class="text-xs bg-gray-100 text-gray-600 px-2 py-1 rounded flex-shrink-0">{report.data.date}</span>
              </div>
              <p class="text-gray-600 text-sm mb-4">{report.data.description}</p>
              <div class="flex items-center gap-3">
                <a 
                  href={report.data.file}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-2 px-3 py-1.5 border border-primary text-primary rounded-lg hover:bg-primary hover:text-white transition-colors text-sm font-medium"
                  aria-label={`View ${report.data.title} online`}
                >
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
                  </svg>
                  View
                </a>
                <a 
                  href={report.data.file}
                  download
                  class="inline-flex items-center gap-2 px-3 py-1.5 bg-primary text-white rounded-lg hover:bg-primary-dark transition-colors text-sm font-medium"
                  aria-label={`Download ${report.data.title}`}
                >
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
                  </svg>
                  Download
                </a>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    {/* Meeting Notices */}
    <section class="py-16 md:py-24 bg-white">
      <div class="container mx-auto px-4 max-w-4xl">
        <div class="text-center mb-12">
          <h2 class="font-display text-3xl font-bold text-primary">{transparencySettings.data.meetingNoticesTitle}</h2>
          <p class="mt-4 text-gray-600">
            {transparencySettings.data.meetingNoticesDescription}
          </p>
        </div>

        <div class="bg-[#faf9f7] rounded-xl overflow-hidden">
          <table class="w-full">
            <thead class="bg-primary text-white">
              <tr>
                <th class="text-left px-6 py-4 font-medium">Meeting Title</th>
                <th class="text-left px-6 py-4 font-medium">Date</th>
                <th class="text-left px-6 py-4 font-medium">Type</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-200">
              {enabledMeetingNotices.map((notice) => (
                <tr class="hover:bg-white transition-colors">
                  <td class="px-6 py-4 font-medium text-gray-900">{notice.data.title}</td>
                  <td class="px-6 py-4 text-gray-600">{notice.data.date}</td>
                  <td class="px-6 py-4">
                    <span class="text-xs bg-primary/10 text-primary px-2 py-1 rounded">{notice.data.type}</span>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </section>

    {/* Bank Account Info */}
    <section class="py-16 md:py-20 bg-[#faf9f7]">
      <div class="container mx-auto px-4 max-w-3xl">
        <div class="bg-white rounded-xl p-8 md:p-12 shadow-sm text-center">
          <h2 class="font-display text-2xl font-bold text-primary mb-6">{transparencySettings.data.bankDetailsTitle}</h2>
          <p class="text-gray-600 mb-8">
            {transparencySettings.data.bankDetailsDescription}
          </p>
          
          <div class="bg-[#faf9f7] rounded-xl p-8 max-w-md mx-auto">
            <div class="space-y-4 text-left">
              <div>
                <p class="text-sm text-gray-500">Account Name</p>
                <p class="font-display text-lg font-bold text-gray-900">{bankDetails.data.accountName}</p>
              </div>
              <div>
                <p class="text-sm text-gray-500">Account Number</p>
                <p class="font-display text-2xl font-bold text-primary">{bankDetails.data.accountNumber}</p>
              </div>
              <div>
                <p class="text-sm text-gray-500">Bank</p>
                <p class="font-medium text-gray-900">{bankDetails.data.bankName}</p>
              </div>
            </div>
          </div>

          <div class="mt-8">
            <Button href="/get-involved" variant="primary">
              Donate Online
            </Button>
          </div>
        </div>
      </div>
    </section>

    {/* Accountability Statement */}
    <section class="py-16 md:py-24 bg-primary text-white">
      <div class="container mx-auto px-4 max-w-4xl text-center">
        <h2 class="font-display text-3xl font-bold mb-6">{transparencySettings.data.accountabilityTitle}</h2>
        <p class="text-lg leading-relaxed opacity-90 mb-8">
          {transparencySettings.data.accountabilityDescription}
        </p>
        <div class="flex flex-col sm:flex-row justify-center gap-4">
          <Button href="/contact" variant="white">
            Contact Us for More Info
          </Button>
          <Button href="/gallery" variant="outline-white">
            View Our Gallery
          </Button>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
