---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/sections/Navbar.astro';
import Footer from '../components/sections/Footer.astro';
import Icon from '../components/ui/Icon.astro';
import Button from '../components/ui/Button.astro';

const title = "Contact Us | Dr. Patience Tsavnande Foundation";
const description = "We'd love to hear from you. Whether you have a question, a suggestion, or want to partner with us, feel free to reach out.";

const contactDetails = [
  {
    icon: 'map-pin',
    title: 'Address',
    value: 'No. 13 Tunisia Crescent, Barnawa Phase 1, Kaduna.',
  },
  {
    icon: 'mail',
    title: 'Email',
    value: 'nelson@drtsavnandefoundation.com',
    href: 'mailto:nelson@drtsavnandefoundation.com',
  },
  {
    icon: 'phone',
    title: 'Phone',
    value: '+234 703 498 0459',
    href: 'tel:+2347034980459',
  },
];
---

<Layout title={title} description={description}>
  <Navbar />
  <main id="main-content" class="pt-20">
    <div class="container mx-auto px-4 py-16 md:py-24">
      <header class="text-center mb-16">
        <h1 class="font-display text-4xl md:text-5xl font-bold text-primary">Get in Touch</h1>
        <p class="mt-4 text-lg text-gray-600 max-w-2xl mx-auto">
          We'd love to hear from you. Whether you have a question, a suggestion, or want to partner with us, feel free to reach out.
        </p>
      </header>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 max-w-6xl mx-auto">
        <!-- Contact Information -->
        <div class="bg-white p-8 rounded-2xl shadow-lg">
          <h2 class="font-display text-3xl mb-6">Contact Information</h2>
          <div class="space-y-6">
            {contactDetails.map((detail) => (
              <div class="flex items-start gap-4">
                <div class="flex-shrink-0 mt-1">
                  <Icon name={detail.icon} class="w-8 h-8 text-primary" />
                </div>
                <div>
                  <h3 class="text-xl font-semibold">{detail.title}</h3>
                  {detail.href ? (
                    <a href={detail.href} class="text-gray-600 hover:text-primary transition-colors">
                      {detail.value}
                    </a>
                  ) : (
                    <p class="text-gray-600">{detail.value}</p>
                  )}
                </div>
              </div>
            ))}
          </div>

          <!-- Social Links -->
          <div class="mt-10 pt-8 border-t border-gray-200">
            <h3 class="font-display text-xl font-semibold mb-4">Follow Us</h3>
            <div class="flex items-center gap-4">
              <a href="https://facebook.com" target="_blank" rel="noopener noreferrer" aria-label="Follow DPTF on Facebook" class="w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center text-primary hover:bg-primary hover:text-white transition-colors">
                <Icon name="facebook" class="w-6 h-6" />
              </a>
              <a href="https://www.instagram.com/drpst_foundation?igsh=ZDNlNWI3OGM5b3lr" target="_blank" rel="noopener noreferrer" aria-label="Follow DPTF on Instagram" class="w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center text-primary hover:bg-primary hover:text-white transition-colors">
                <Icon name="instagram" class="w-6 h-6" />
              </a>
            </div>
          </div>
        </div>

        <!-- Contact Form -->
        <div class="bg-white p-8 rounded-2xl shadow-lg">
          <h2 class="font-display text-3xl mb-6">Send Us a Message</h2>
          
          <form id="contactForm" class="space-y-6">
            <div>
              <label for="name" class="block text-sm font-medium text-gray-700 mb-2">Your Name</label>
              <input 
                type="text" 
                id="name" 
                name="name" 
                required
                placeholder="John Doe"
                class="w-full px-4 py-3 rounded-xl border border-gray-200 focus:border-primary focus:ring-2 focus:ring-primary/20 outline-none transition-all"
              />
            </div>
            
            <div>
              <label for="email" class="block text-sm font-medium text-gray-700 mb-2">Your Email</label>
              <input 
                type="email" 
                id="email" 
                name="email" 
                required
                placeholder="john.doe@example.com"
                class="w-full px-4 py-3 rounded-xl border border-gray-200 focus:border-primary focus:ring-2 focus:ring-primary/20 outline-none transition-all"
              />
            </div>
            
            <div>
              <label for="subject" class="block text-sm font-medium text-gray-700 mb-2">Subject</label>
              <input 
                type="text" 
                id="subject" 
                name="subject" 
                required
                placeholder="Regarding a donation"
                class="w-full px-4 py-3 rounded-xl border border-gray-200 focus:border-primary focus:ring-2 focus:ring-primary/20 outline-none transition-all"
              />
            </div>
            
            <div>
              <label for="message" class="block text-sm font-medium text-gray-700 mb-2">Message</label>
              <textarea 
                id="message" 
                name="message" 
                rows="4" 
                required
                placeholder="Tell us how we can help"
                class="w-full px-4 py-3 rounded-xl border border-gray-200 focus:border-primary focus:ring-2 focus:ring-primary/20 outline-none transition-all resize-none"
              ></textarea>
            </div>
            
            <button 
              type="submit" 
              class="w-full bg-primary text-white font-display font-semibold py-4 rounded-xl hover:bg-primary-dark transition-colors flex items-center justify-center gap-2"
            >
              <span class="btn-text flex items-center gap-2">
                <Icon name="send" class="w-5 h-5" />
                Send Message
              </span>
              <span class="btn-loading hidden items-center gap-2">
                <svg class="animate-spin h-5 w-5" viewBox="0 0 24 24">
                  <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4" fill="none"/>
                  <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"/>
                </svg>
                Sending...
              </span>
            </button>
          </form>
          
          <!-- Success Message -->
          <div id="formSuccess" class="hidden text-center py-8">
            <div class="w-16 h-16 bg-success/10 rounded-full flex items-center justify-center mx-auto mb-4">
              <Icon name="check" class="w-8 h-8 text-success" />
            </div>
            <h4 class="font-display text-xl font-bold text-dark mb-2">Thank You!</h4>
            <p class="text-gray-600 mb-6">We've received your message. Our team will get back to you shortly.</p>
            <Button variant="outline" onclick="document.getElementById('contactForm').style.display='block'; document.getElementById('formSuccess').classList.add('hidden'); document.getElementById('contactForm').reset();">
              Send Another Message
            </Button>
          </div>
        </div>
      </div>
    </div>
  </main>
  <Footer />
</Layout>
