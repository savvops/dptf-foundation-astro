---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/sections/Navbar.astro';
import Footer from '../components/sections/Footer.astro';
import Button from '../components/ui/Button.astro';

const title = "Our Work | Dr. Patience Tsavnande Foundation";
const description = "Explore our programs: Medical Outreach, Educational Support, Food Security, and Annual Memorial Activities. See how we're making a difference.";

// Calculate next memorial date for structured data
const today = new Date();
const currentYear = today.getFullYear();
let memorialYear = currentYear;
let memorialDate = new Date(currentYear, 8, 15); // September 15
if (today > memorialDate) {
  memorialYear = currentYear + 1;
}

// Event structured data for SEO
const memorialEventSchema = {
  "@context": "https://schema.org",
  "@type": "Event",
  "name": "Annual Memorial Thanksgiving Mass - Dr. Patience Tsavnande Foundation",
  "description": "Annual commemoration of Dr. Patience Tsavnande's life and legacy. Join us for a Thanksgiving Mass at Holy Family Catholic Church.",
  "startDate": `${memorialYear}-09-15T10:00:00`,
  "eventStatus": "https://schema.org/EventScheduled",
  "eventAttendanceMode": "https://schema.org/OfflineEventAttendanceMode",
  "location": {
    "@type": "Place",
    "name": "Holy Family Catholic Church",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "Barnawa",
      "addressLocality": "Kaduna",
      "addressCountry": "NG"
    }
  },
  "organizer": {
    "@type": "NGO",
    "name": "Dr. Patience Tsavnande Foundation",
    "url": "https://dptf-foundation.pages.dev"
  }
};

const programs = [
  {
    id: "medical",
    title: "Medical Outreach",
    icon: "heart-pulse",
    description: "Providing free healthcare services to underserved communities across Nigeria.",
    stats: [
      { value: "1,053+", label: "Patients Treated" },
      { value: "3", label: "Major Outreaches" },
      { value: "2020", label: "Started" }
    ],
    highlights: [
      "Free medical consultations and treatments",
      "Distribution of medications and medical supplies",
      "Health education and awareness programs",
      "Partnerships with local hospitals and medical professionals"
    ],
    outreaches: [
      {
        title: "First Medical Outreach - Tarka LGA",
        date: "December 2-3, 2020",
        location: "Atighir Village, Tarka LGA, Benue State",
        impact: "Treated 1,053+ patients over 2 days",
        description: "Our inaugural medical outreach in Dr. Patience's home community provided free healthcare services including consultations, medications, and health education. The event was attended by community leaders including the Chairman of Tarka LGA."
      },
      {
        title: "School Medical Outreach",
        date: "November 25, 2023",
        location: "Our Lady of Fatima Girls Secondary School, Kaduna",
        impact: "Health symposium and medical checkups for students",
        description: "A mini medical outreach combining a health symposium with practical medical checkups for students. The Foundation received an award and letter of appreciation from the school for this initiative."
      },
      {
        title: "Hospital Intervention Program",
        date: "September 16-21, 2024",
        location: "St. Gerard Catholic Hospital (Veritas University Teaching Hospital), Kakuri, Kaduna",
        impact: "1-week accident & emergency support",
        description: "In partnership with Veritas University Teaching Hospital, the Foundation supplied medical consumables for the treatment of accident and emergency patients for one week, marking the 5th anniversary of Dr. Patience's passing."
      }
    ]
  },
  {
    id: "education",
    title: "Educational Support",
    icon: "graduation-cap",
    description: "Supporting education through scholarships, prizes, and educational material donations.",
    stats: [
      { value: "₦300K", label: "Annual Prize" },
      { value: "2020/21", label: "Started" },
      { value: "BSU", label: "Partner University" }
    ],
    highlights: [
      "Annual prize for Best Graduating Female Medical Doctor at BSU",
      "Scholarship programs for deserving students",
      "Donation of educational materials to schools",
      "Support for medical education and training"
    ],
    initiatives: [
      {
        title: "BSU Best Female Medical Doctor Prize",
        description: "The Foundation instituted an annual prize of ₦300,000 for the Best Graduating Female Medical Doctor at Benue State University, Makurdi, starting from the 2020/2021 academic session. The prize is presented during the university's convocation ceremony.",
        date: "Annual (Since 2021)"
      },
      {
        title: "Educational Materials Donation",
        description: "In June 2021, the Foundation donated educational materials to Kadwell International School, Barnawa. The materials were generously provided by Lady Phil Iyoha, a member of the Advisory Board.",
        date: "June 2021"
      },
      {
        title: "Scholarship Program",
        description: "The Foundation has launched a scholarship program calling for applications from deserving students. Details on eligibility and application process are announced annually.",
        date: "Ongoing"
      }
    ]
  },
  {
    id: "food",
    title: "Food Security",
    icon: "utensils",
    description: "Combating hunger through food distribution programs for vulnerable communities.",
    stats: [
      { value: "1,000+", label: "Target Beneficiaries" },
      { value: "Multiple", label: "Food Items" },
      { value: "AHEF", label: "Partner NGO" }
    ],
    highlights: [
      "Operation Feed the North program",
      "Distribution of essential food items",
      "Partnership with AHEF NGO",
      "Targeted support for the poor and vulnerable"
    ],
    items: [
      "Rice and beans",
      "Garri and spaghetti",
      "Cooking oil",
      "Indomie noodles",
      "Tomatoes and onions",
      "Yams and groundnut oil"
    ]
  }
];

const memorialActivities = {
  title: "Annual Memorial Activities",
  description: "Each year on September 15th, we commemorate Dr. Patience's passing with special programs that honor her memory and continue her work.",
  activities: [
    {
      title: "Thanksgiving Mass",
      description: "An annual Thanksgiving Mass held at Holy Family Catholic Church, Barnawa, Kaduna, to celebrate Dr. Patience's life and pray for the repose of her soul.",
      when: "September 15/17 annually"
    },
    {
      title: "Memorial Symposium",
      description: "Educational symposiums held in partnership with schools and institutions to discuss health and educational topics.",
      when: "Annually"
    },
    {
      title: "Community Service",
      description: "Special outreach programs and community service activities organized around the memorial period.",
      when: "September annually"
    }
  ]
};
---

<Layout title={title} description={description} additionalSchema={memorialEventSchema}>
  <Navbar />
  <main id="main-content" class="flex flex-col">
    <!-- Hero Section -->
    <section class="bg-secondary py-16 md:py-24 pt-32">
      <div class="container mx-auto px-4 text-center">
        <h1 class="font-display text-4xl md:text-5xl font-bold text-primary">Our Programs</h1>
        <p class="mt-4 text-lg text-gray-600 max-w-3xl mx-auto leading-relaxed">
          Through medical outreach, educational support, and food security programs, we continue Dr. Patience's mission of service to humanity.
        </p>
      </div>
    </section>

    {/* Programs Navigation */}
    <section class="bg-white border-b border-gray-200 sticky top-20 z-40">
      <div class="container mx-auto px-4 py-4">
        <div class="flex flex-wrap justify-center gap-4">
          {programs.map((program) => (
            <a 
              href={`#${program.id}`}
              class="px-4 py-2 rounded-full bg-gray-100 hover:bg-primary hover:text-white transition-colors text-sm font-medium"
            >
              {program.title}
            </a>
          ))}
          <a 
            href="#memorial"
            class="px-4 py-2 rounded-full bg-gray-100 hover:bg-primary hover:text-white transition-colors text-sm font-medium"
          >
            Memorial Activities
          </a>
        </div>
      </div>
    </section>

    {/* Programs Detail Sections */}
    {programs.map((program, index) => (
      <section id={program.id} class={`py-16 md:py-24 ${index % 2 === 0 ? 'bg-white' : 'bg-[#faf9f7]'}`}>
        <div class="container mx-auto px-4">
          {/* Program Header */}
          <div class="max-w-4xl mx-auto text-center mb-16">
            <h2 class="font-display text-3xl md:text-4xl font-bold text-primary">{program.title}</h2>
            <p class="mt-4 text-lg text-gray-600">{program.description}</p>
          </div>

          {/* Stats */}
          {program.stats && (
            <div class="grid grid-cols-3 gap-8 max-w-3xl mx-auto mb-16">
              {program.stats.map((stat) => (
                <div class="text-center">
                  <p class="font-display text-3xl md:text-4xl font-bold text-primary">{stat.value}</p>
                  <p class="text-gray-600 text-sm mt-1">{stat.label}</p>
                </div>
              ))}
            </div>
          )}

          {/* Highlights */}
          {program.highlights && (
            <div class="max-w-4xl mx-auto mb-16">
              <h3 class="font-display text-xl font-bold text-gray-900 mb-6 text-center">Program Highlights</h3>
              <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                {program.highlights.map((highlight) => (
                  <div class="flex items-start gap-3">
                    <div class="w-2 h-2 rounded-full bg-primary mt-2 flex-shrink-0"></div>
                    <p class="text-gray-600">{highlight}</p>
                  </div>
                ))}
              </div>
            </div>
          )}

          {/* Specific Program Content */}
          {program.id === "medical" && program.outreaches && (
            <div class="max-w-5xl mx-auto">
              <h3 class="font-display text-2xl font-bold text-gray-900 mb-8 text-center">Our Medical Outreaches</h3>
              <div class="space-y-8">
                {program.outreaches.map((outreach) => (
                  <div class="bg-white rounded-xl p-8 shadow-sm border border-gray-100">
                    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4 mb-4">
                      <h4 class="font-display text-xl font-bold text-primary">{outreach.title}</h4>
                      <span class="text-sm text-gray-500 bg-gray-100 px-3 py-1 rounded-full">{outreach.date}</span>
                    </div>
                    <p class="text-gray-600 mb-4">{outreach.description}</p>
                    <div class="flex flex-wrap gap-4 text-sm">
                      <span class="text-gray-500">
                        <strong>Location:</strong> {outreach.location}
                      </span>
                      <span class="text-primary font-medium">
                        <strong>Impact:</strong> {outreach.impact}
                      </span>
                    </div>
                  </div>
                ))}
              </div>
            </div>
          )}

          {program.id === "education" && program.initiatives && (
            <div class="max-w-5xl mx-auto">
              <h3 class="font-display text-2xl font-bold text-gray-900 mb-8 text-center">Educational Initiatives</h3>
              <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                {program.initiatives.map((initiative) => (
                  <div class="bg-white rounded-xl p-6 shadow-sm border border-gray-100">
                    <span class="text-xs text-primary font-medium uppercase tracking-wide">{initiative.date}</span>
                    <h4 class="font-display text-lg font-bold text-gray-900 mt-2 mb-3">{initiative.title}</h4>
                    <p class="text-gray-600 text-sm">{initiative.description}</p>
                  </div>
                ))}
              </div>
            </div>
          )}

          {program.id === "food" && program.items && (
            <div class="max-w-4xl mx-auto">
              <h3 class="font-display text-2xl font-bold text-gray-900 mb-8 text-center">Operation Feed the North</h3>
              <p class="text-gray-600 text-center mb-8">
                In partnership with AHEF NGO, we distribute essential food items to vulnerable communities. Our goal is to reach 1,000+ beneficiaries with comprehensive food packages.
              </p>
              <div class="grid grid-cols-2 md:grid-cols-3 gap-4">
                {program.items.map((item) => (
                  <div class="bg-white rounded-lg p-4 text-center shadow-sm">
                    <p class="text-gray-700 font-medium">{item}</p>
                  </div>
                ))}
              </div>
            </div>
          )}

          {/* Gallery Link */}
          <div class="text-center mt-12">
            <Button href="/gallery" variant="outline">
              View {program.title} Photos
            </Button>
          </div>
        </div>
      </section>
    ))}

    {/* Memorial Activities Section */}
    <section id="memorial" class="py-16 md:py-24 bg-[#faf9f7]">
      <div class="container mx-auto px-4">
        <div class="max-w-4xl mx-auto">
          <div class="text-center mb-12">
            <h2 class="font-display text-3xl md:text-4xl font-bold text-primary">{memorialActivities.title}</h2>
            <p class="mt-4 text-lg text-gray-600">{memorialActivities.description}</p>
          </div>
          
          <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
            {memorialActivities.activities.map((activity) => (
              <div class="bg-white rounded-xl p-8 shadow-sm text-center">
                <h3 class="font-display text-xl font-bold text-gray-900 mb-3">{activity.title}</h3>
                <p class="text-gray-600 mb-4">{activity.description}</p>
                <span class="text-sm text-primary font-medium">{activity.when}</span>
              </div>
            ))}
          </div>

          <div class="mt-12 bg-primary/5 rounded-xl p-8 text-center">
            <h3 class="font-display text-xl font-bold text-primary mb-4">Next Memorial</h3>
            <p class="text-2xl font-display font-bold text-gray-900" id="nextMemorialDateWork">September 15, 2026</p>
            <p class="text-gray-600 mt-2">Holy Family Catholic Church, Barnawa, Kaduna</p>
            <p class="text-sm text-primary font-medium mt-2" id="memorialCountdownWork"></p>
            <p class="text-sm text-gray-500 mt-4">All are invited to join us in remembrance and prayer</p>
          </div>
        </div>
      </div>
    </section>

    {/* Impact CTA */}
    <section class="py-16 md:py-24 bg-primary text-white">
      <div class="container mx-auto px-4 text-center max-w-3xl">
        <h2 class="font-display text-3xl md:text-4xl font-bold">
          Help Us Do More
        </h2>
        <p class="mt-4 text-lg leading-relaxed opacity-90">
          Your support enables us to reach more communities, treat more patients, educate more students, and feed more families. Every donation brings us closer to realizing Dr. Patience's dream.
        </p>
        <div class="mt-8 flex flex-col sm:flex-row justify-center gap-4">
          <Button href="/get-involved" variant="white" size="lg">
            Donate Now
          </Button>
          <Button href="/transparency" variant="outline-white" size="lg">
            See Our Impact
          </Button>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<script>
  // Dynamic Memorial Date
  function updateMemorialDate() {
    const today = new Date();
    const currentYear = today.getFullYear();
    let memorialDate = new Date(currentYear, 8, 15); // September 15
    
    if (today > memorialDate) {
      memorialDate = new Date(currentYear + 1, 8, 15);
    }
    
    const options = { year: 'numeric', month: 'long', day: 'numeric' };
    document.getElementById('nextMemorialDateWork').textContent = memorialDate.toLocaleDateString('en-US', options);
    
    const daysUntil = Math.ceil((memorialDate - today) / (1000 * 60 * 60 * 24));
    const countdownText = daysUntil === 0 ? 'Today!' : daysUntil === 1 ? 'Tomorrow!' : `${daysUntil} days away`;
    document.getElementById('memorialCountdownWork').textContent = countdownText;
  }
  
  updateMemorialDate();
</script>
