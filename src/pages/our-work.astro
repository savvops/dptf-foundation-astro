---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/sections/Navbar.astro';
import Footer from '../components/sections/Footer.astro';
import Button from '../components/ui/Button.astro';
import { getCollection, getEntry } from 'astro:content';

// Load Our Work settings
const ourWorkSettings = await getEntry('ourWorkSettings', 'settings');

// Load programs
const programs = await getCollection('programs');
const enabledPrograms = programs
  .filter(p => p.data.enabled)
  .sort((a, b) => a.data.order - b.data.order);

// Load medical outreaches
const medicalOutreaches = await getCollection('medicalOutreaches');
const enabledMedicalOutreaches = medicalOutreaches
  .filter(o => o.data.enabled)
  .sort((a, b) => a.data.order - b.data.order);

// Load education initiatives
const educationInitiatives = await getCollection('educationInitiatives');
const enabledEducationInitiatives = educationInitiatives
  .filter(i => i.data.enabled)
  .sort((a, b) => a.data.order - b.data.order);

// Load food security items
const foodSecurityItems = await getCollection('foodSecurity');
const enabledFoodItems = foodSecurityItems
  .filter(item => item.data.enabled)
  .sort((a, b) => a.data.order - b.data.order);

// Load memorial activities
const memorialActivities = await getCollection('memorialActivities');
const enabledMemorialActivities = memorialActivities
  .filter(a => a.data.enabled)
  .sort((a, b) => a.data.order - b.data.order);

// Calculate next memorial date for structured data
const today = new Date();
const currentYear = today.getFullYear();
let memorialYear = currentYear;
let memorialDate = new Date(currentYear, 8, 15); // September 15
if (today > memorialDate) {
  memorialYear = currentYear + 1;
}

// Event structured data for SEO
const memorialEventSchema = {
  "@context": "https://schema.org",
  "@type": "Event",
  "name": "Annual Memorial Thanksgiving Mass - Dr. Patience Tsavnande Foundation",
  "description": "Annual commemoration of Dr. Patience Tsavnande's life and legacy. Join us for a Thanksgiving Mass at Holy Family Catholic Church.",
  "startDate": `${memorialYear}-09-15T10:00:00`,
  "eventStatus": "https://schema.org/EventScheduled",
  "eventAttendanceMode": "https://schema.org/OfflineEventAttendanceMode",
  "location": {
    "@type": "Place",
    "name": "Holy Family Catholic Church",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "Barnawa",
      "addressLocality": "Kaduna",
      "addressCountry": "NG"
    }
  },
  "organizer": {
    "@type": "NGO",
    "name": "Dr. Patience Tsavnande Foundation",
    "url": "https://dptf-foundation.pages.dev"
  }
};
---

<Layout 
  title={ourWorkSettings.data.pageTitle} 
  description={ourWorkSettings.data.pageDescription} 
  additionalSchema={memorialEventSchema}
>
  <Navbar />
  <main id="main-content" class="flex flex-col">
    <!-- Hero Section -->
    <section class="bg-secondary py-16 md:py-24 pt-32">
      <div class="container mx-auto px-4 text-center">
        <h1 class="font-display text-4xl md:text-5xl font-bold text-primary">{ourWorkSettings.data.heroTitle}</h1>
        <p class="mt-4 text-lg text-gray-600 max-w-3xl mx-auto leading-relaxed">
          {ourWorkSettings.data.heroDescription}
        </p>
      </div>
    </section>

    {/* Programs Navigation */}
    <section class="bg-white border-b border-gray-200 sticky top-20 z-40">
      <div class="container mx-auto px-4 py-4">
        <div class="flex flex-wrap justify-center gap-4">
          {enabledPrograms.map((program) => (
            <a 
              href={`#${program.data.id}`}
              class="px-4 py-2 rounded-full bg-gray-100 hover:bg-primary hover:text-white transition-colors text-sm font-medium"
            >
              {program.data.title}
            </a>
          ))}
          <a 
            href="#memorial"
            class="px-4 py-2 rounded-full bg-gray-100 hover:bg-primary hover:text-white transition-colors text-sm font-medium"
          >
            Memorial Activities
          </a>
        </div>
      </div>
    </section>

    {/* Programs Detail Sections */}
    {enabledPrograms.map((program, index) => (
      <section id={program.data.id} class={`py-16 md:py-24 ${index % 2 === 0 ? 'bg-white' : 'bg-[#faf9f7]'}`}>
        <div class="container mx-auto px-4">
          {/* Program Header */}
          <div class="max-w-4xl mx-auto text-center mb-16">
            <h2 class="font-display text-3xl md:text-4xl font-bold text-primary">{program.data.title}</h2>
            <p class="mt-4 text-lg text-gray-600">{program.data.description}</p>
          </div>

          {/* Stats */}
          {program.data.stats && (
            <div class="grid grid-cols-3 gap-8 max-w-3xl mx-auto mb-16">
              {program.data.stats.map((stat) => (
                <div class="text-center">
                  <p class="font-display text-3xl md:text-4xl font-bold text-primary">{stat.value}</p>
                  <p class="text-gray-600 text-sm mt-1">{stat.label}</p>
                </div>
              ))}
            </div>
          )}

          {/* Highlights */}
          {program.data.highlights && (
            <div class="max-w-4xl mx-auto mb-16">
              <h3 class="font-display text-xl font-bold text-gray-900 mb-6 text-center">Program Highlights</h3>
              <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                {program.data.highlights.map((highlight) => (
                  <div class="flex items-start gap-3">
                    <div class="w-2 h-2 rounded-full bg-primary mt-2 flex-shrink-0"></div>
                    <p class="text-gray-600">{highlight}</p>
                  </div>
                ))}
              </div>
            </div>
          )}

          {/* Specific Program Content */}
          {program.data.id === "medical" && enabledMedicalOutreaches.length > 0 && (
            <div class="max-w-5xl mx-auto">
              <h3 class="font-display text-2xl font-bold text-gray-900 mb-8 text-center">Our Medical Outreaches</h3>
              <div class="space-y-8">
                {enabledMedicalOutreaches.map((outreach) => (
                  <div class="bg-white rounded-xl p-8 shadow-sm border border-gray-100">
                    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4 mb-4">
                      <h4 class="font-display text-xl font-bold text-primary">{outreach.data.title}</h4>
                      <span class="text-sm text-gray-500 bg-gray-100 px-3 py-1 rounded-full">{outreach.data.date}</span>
                    </div>
                    <p class="text-gray-600 mb-4">{outreach.data.description}</p>
                    <div class="flex flex-wrap gap-4 text-sm">
                      <span class="text-gray-500">
                        <strong>Location:</strong> {outreach.data.location}
                      </span>
                      <span class="text-primary font-medium">
                        <strong>Impact:</strong> {outreach.data.impact}
                      </span>
                    </div>
                  </div>
                ))}
              </div>
            </div>
          )}

          {program.data.id === "education" && enabledEducationInitiatives.length > 0 && (
            <div class="max-w-5xl mx-auto">
              <h3 class="font-display text-2xl font-bold text-gray-900 mb-8 text-center">Educational Initiatives</h3>
              <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                {enabledEducationInitiatives.map((initiative) => (
                  <div class="bg-white rounded-xl p-6 shadow-sm border border-gray-100">
                    <span class="text-xs text-primary font-medium uppercase tracking-wide">{initiative.data.date}</span>
                    <h4 class="font-display text-lg font-bold text-gray-900 mt-2 mb-3">{initiative.data.title}</h4>
                    <p class="text-gray-600 text-sm">{initiative.data.description}</p>
                  </div>
                ))}
              </div>
            </div>
          )}

          {program.data.id === "food" && enabledFoodItems.length > 0 && (
            <div class="max-w-4xl mx-auto">
              <h3 class="font-display text-2xl font-bold text-gray-900 mb-8 text-center">Operation Feed the North</h3>
              <p class="text-gray-600 text-center mb-8">
                In partnership with AHEF NGO, we distribute essential food items to vulnerable communities. Our goal is to reach 1,000+ beneficiaries with comprehensive food packages.
              </p>
              <div class="grid grid-cols-2 md:grid-cols-3 gap-4">
                {enabledFoodItems.map((item) => (
                  <div class="bg-white rounded-lg p-4 text-center shadow-sm">
                    <p class="text-gray-700 font-medium">{item.data.item}</p>
                  </div>
                ))}
              </div>
            </div>
          )}

          {/* Gallery Link */}
          <div class="text-center mt-12">
            <Button href="/gallery" variant="outline">
              View {program.data.title} Photos
            </Button>
          </div>
        </div>
      </section>
    ))}

    {/* Memorial Activities Section */}
    <section id="memorial" class="py-16 md:py-24 bg-[#faf9f7]">
      <div class="container mx-auto px-4">
        <div class="max-w-4xl mx-auto">
          <div class="text-center mb-12">
            <h2 class="font-display text-3xl md:text-4xl font-bold text-primary">{ourWorkSettings.data.memorialSectionTitle}</h2>
            <p class="mt-4 text-lg text-gray-600">{ourWorkSettings.data.memorialSectionDescription}</p>
          </div>
          
          <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
            {enabledMemorialActivities.map((activity) => (
              <div class="bg-white rounded-xl p-8 shadow-sm text-center">
                <h3 class="font-display text-xl font-bold text-gray-900 mb-3">{activity.data.title}</h3>
                <p class="text-gray-600 mb-4">{activity.data.description}</p>
                <span class="text-sm text-primary font-medium">{activity.data.when}</span>
              </div>
            ))}
          </div>

          <div class="mt-12 bg-primary/5 rounded-xl p-8 text-center">
            <h3 class="font-display text-xl font-bold text-primary mb-4">Next Memorial</h3>
            <p class="text-2xl font-display font-bold text-gray-900" id="nextMemorialDateWork">September 15, {memorialYear}</p>
            <p class="text-gray-600 mt-2">Holy Family Catholic Church, Barnawa, Kaduna</p>
            <p class="text-sm text-primary font-medium mt-2" id="memorialCountdownWork"></p>
            <p class="text-sm text-gray-500 mt-4">All are invited to join us in remembrance and prayer</p>
          </div>
        </div>
      </div>
    </section>

    {/* Impact CTA */}
    <section class="py-16 md:py-24 bg-primary text-white">
      <div class="container mx-auto px-4 text-center max-w-3xl">
        <h2 class="font-display text-3xl md:text-4xl font-bold">
          {ourWorkSettings.data.impactCtaTitle}
        </h2>
        <p class="mt-4 text-lg leading-relaxed opacity-90">
          {ourWorkSettings.data.impactCtaDescription}
        </p>
        <div class="mt-8 flex flex-col sm:flex-row justify-center gap-4">
          <Button href="/get-involved" variant="white" size="lg">
            Donate Now
          </Button>
          <Button href="/transparency" variant="outline-white" size="lg">
            See Our Impact
          </Button>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<script>
  // Dynamic Memorial Date
  function updateMemorialDate() {
    const today = new Date();
    const currentYear = today.getFullYear();
    let memorialDate = new Date(currentYear, 8, 15); // September 15
    
    if (today > memorialDate) {
      memorialDate = new Date(currentYear + 1, 8, 15);
    }
    
    const options = { year: 'numeric', month: 'long', day: 'numeric' };
    const dateEl = document.getElementById('nextMemorialDateWork');
    if (dateEl) {
      dateEl.textContent = memorialDate.toLocaleDateString('en-US', options);
    }
    
    const daysUntil = Math.ceil((memorialDate - today) / (1000 * 60 * 60 * 24));
    const countdownText = daysUntil === 0 ? 'Today!' : daysUntil === 1 ? 'Tomorrow!' : `${daysUntil} days away`;
    const countdownEl = document.getElementById('memorialCountdownWork');
    if (countdownEl) {
      countdownEl.textContent = countdownText;
    }
  }
  
  updateMemorialDate();
</script>
