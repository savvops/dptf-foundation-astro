---
import { getCollection } from 'astro:content';
import Icon from '../ui/Icon.astro';

const objectives = await getCollection('objectives');
const sortedObjectives = objectives.sort((a, b) => a.data.order - b.data.order);
---

<section id="objectives" class="py-16 md:py-24 bg-[#faf9f7]">
  <div class="container mx-auto px-4">
    <h2 class="font-display text-3xl md:text-4xl font-bold text-center mb-12">
      Our Core Objectives
    </h2>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {sortedObjectives.map((objective, index) => (
        <div class="reveal opacity-0 translate-y-8 bg-white rounded-2xl p-8 text-center shadow-lg hover:shadow-xl transition-all duration-300 hover:-translate-y-1" style={`transition-delay: ${index * 100}ms`}>
          <div class="mx-auto flex items-center justify-center h-20 w-20 rounded-full bg-primary/10 mb-6">
            <Icon name={objective.data.icon} class="w-10 h-10 text-primary" />
          </div>
          <h3 class="font-display text-2xl font-semibold mb-3">{objective.data.title}</h3>
          <p class="text-gray-600">{objective.data.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>
