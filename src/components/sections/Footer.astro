---
import Icon from '../ui/Icon.astro';
import { getCollection, getEntry } from 'astro:content';

// Load footer settings
const footerSettings = await getEntry('footerSettings', 'settings');
const bankDetails = await getEntry('bankDetails', 'details');

// Load footer links
const footerLinks = await getCollection('footerLinks');
const quickLinks = footerLinks
  .filter(link => link.data.category === 'quick' && link.data.enabled)
  .sort((a, b) => a.data.order - b.data.order);
const resourceLinks = footerLinks
  .filter(link => link.data.category === 'resources' && link.data.enabled)
  .sort((a, b) => a.data.order - b.data.order);

// Load contact info
const contactInfo = await getCollection('contactInfo');
const enabledContactInfo = contactInfo
  .filter(item => item.data.enabled)
  .sort((a, b) => a.data.order - b.data.order);

// Load social links
const socialLinks = await getCollection('socialLinks');
const enabledSocialLinks = socialLinks
  .filter(link => link.data.enabled)
  .sort((a, b) => a.data.order - b.data.order);

// Load trust badges
const trustBadges = await getCollection('trustBadges');
const enabledTrustBadges = trustBadges
  .filter(badge => badge.data.enabled)
  .sort((a, b) => a.data.order - b.data.order);

// Get site settings for logo
const siteSettings = await getEntry('siteSettings', 'settings');

const currentYear = new Date().getFullYear();
---

<footer class="bg-secondary text-secondary-foreground">
  <div class="container mx-auto px-4 py-12">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-8">
      <!-- Logo & Description -->
      <div class="md:col-span-4">
        <a href="/" class="inline-flex items-center gap-3 mb-4">
          <img 
            src={siteSettings.data.logo} 
            alt="DPTF Logo" 
            class="w-12 h-12 rounded-full object-cover"
            width="48"
            height="48"
            loading="lazy"
            decoding="async"
          />
          <span class="font-display font-bold text-lg">DPTF</span>
        </a>
        <p class="text-sm text-gray-600 mb-4">
          {footerSettings.data.description}
        </p>
        <div class="bg-white/50 rounded-lg p-4">
          <p class="text-xs text-gray-500 uppercase tracking-wide font-semibold mb-2">Bank Details</p>
          <p class="text-sm font-medium text-gray-900">{bankDetails.data.accountName}</p>
          <p class="text-lg font-display font-bold text-primary">{bankDetails.data.accountNumber}</p>
          <p class="text-sm text-gray-600">{bankDetails.data.bankName}</p>
        </div>
      </div>
      
      <!-- Quick Links -->
      <div class="md:col-span-3">
        <h3 class="font-display text-lg font-semibold mb-4">{footerSettings.data.quickLinksTitle}</h3>
        <ul class="space-y-2 text-sm">
          {quickLinks.slice(0, 4).map(link => (
            <li>
              <a href={link.data.href} class="text-gray-600 hover:text-primary transition-colors">
                {link.data.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Resources -->
      <div class="md:col-span-2">
        <h3 class="font-display text-lg font-semibold mb-4">{footerSettings.data.resourcesTitle}</h3>
        <ul class="space-y-2 text-sm">
          {resourceLinks.map(link => (
            <li>
              <a href={link.data.href} class="text-gray-600 hover:text-primary transition-colors">
                {link.data.label}
              </a>
            </li>
          ))}
        </ul>
      </div>
      
      <!-- Contact Us -->
      <div class="md:col-span-3">
        <h3 class="font-display text-lg font-semibold mb-4">{footerSettings.data.contactTitle}</h3>
        <ul class="space-y-3 text-sm">
          {enabledContactInfo.map(item => (
            <li class="flex items-start gap-2">
              <Icon name={item.data.icon} class="w-4 h-4 mt-1 flex-shrink-0 text-primary" />
              {item.data.href ? (
                <a href={item.data.href} class="text-gray-600 hover:text-primary transition-colors">
                  {item.data.value}
                </a>
              ) : (
                <span class="text-gray-600">{item.data.value}</span>
              )}
            </li>
          ))}
        </ul>
        
        <div class="mt-6">
          <a href="/transparency" class="inline-flex items-center gap-2 text-sm text-primary hover:underline">
            <Icon name="file-text" class="w-4 h-4" />
            View Financial Reports
          </a>
        </div>
      </div>
    </div>

    {/* Trust Badges */}
    <div class="mt-8 pt-6 border-t border-gray-200">
      <div class="flex flex-wrap justify-center gap-4 md:gap-8 text-xs text-gray-500">
        {enabledTrustBadges.map(badge => (
          <div class="flex items-center gap-1.5">
            <Icon name={badge.data.icon} class="w-4 h-4 text-primary" />
            <span>{badge.data.label}</span>
          </div>
        ))}
      </div>
    </div>

    <div class="mt-6 pt-6 border-t border-gray-200 flex flex-col sm:flex-row justify-between items-center text-sm text-gray-600">
      <p>&copy; {currentYear} {footerSettings.data.copyrightText}</p>
      <div class="flex items-center gap-4 mt-4 sm:mt-0">
        {enabledSocialLinks.map(link => (
          <a 
            href={link.data.url} 
            target="_blank" 
            rel="noopener noreferrer" 
            aria-label={`Follow DPTF on ${link.data.name}`} 
            class="hover:text-primary transition-colors inline-flex items-center gap-1"
          >
            <Icon name={link.data.icon} class="w-5 h-5" />
            <span class="sr-only">DPTF on {link.data.name}</span>
          </a>
        ))}
      </div>
    </div>
  </div>
</footer>
